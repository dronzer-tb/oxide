+        let reference =
+            std::path::Path::new(concat!(env!("CARGO_MANIFEST_DIR"), "/../../reference"));
+        if !reference.is_dir() {
+            eprintln!(
+                "skipping: no extracted vanilla export at {}",
+                reference.display()
+            );
+            return;
+        }
+        let datapack = oxide_datapack::load_datapack(reference).expect("load reference datapack");
+        let dimension = datapack
+            .dimensions
+            .get(&ResourceLocation::minecraft("overworld"))
+            .expect("overworld dimension");
+        let settings_id = dimension
+            .generator
+            .settings
+            .as_ref()
+            .expect("noise settings");
+        let settings = datapack
+            .noise_settings
+            .get(settings_id)
+            .expect("settings")
+            .clone();
+        let router = NoiseRouterEvaluator::new(
+            12345,
+            &settings,
+            &datapack.density_functions,
+            &datapack.noise_params,
+        );
+        let biome_tree = match dimension.generator.biome_source.as_ref() {
+            Some(oxide_datapack::BiomeSource::MultiNoise(source)) => {
+                oxide_biome::BiomeSearchTree::from_source(source)
+            }
+            _ => None,
+        };
+        let temperatures = BiomeTemperatures::new();
+        assert!(
+            preliminary_snaps_to_quart(&router),
+            "y-independent: {}\n{}",
+            router.is_y_independent(RouterSlot::PreliminarySurfaceLevel),
+            router
+                .dump_program(RouterSlot::PreliminarySurfaceLevel)
+                .join("\n")
+        );
+
+        for (cx, cz) in [(0, 0), (7, -3), (-12, 5), (100, 100), (2000, -2000)] {
+            let pos = ChunkPos::new(cx, cz);
+            // The claim itself, sampled at every column through fresh caches.
+            let caches = router.chunk_caches(cx, cz);
+            for local_z in 0..16 {
+                for local_x in 0..16 {
+                    let x = pos.min_block_x() + local_x;
+                    let z = pos.min_block_z() + local_z;
+                    let slot = RouterSlot::PreliminarySurfaceLevel;
+                    let exact = router.sample_in_chunk(&caches, slot, x, 0, z);
+                    let quart = router.sample_in_chunk(&caches, slot, x & !3, 0, z & !3);
+                    assert_eq!(exact.to_bits(), quart.to_bits(), "column ({x}, {z})");
+                }
+            }
+
+            // And the whole pass, per quart against per column, on one filled chunk.
+            let caches = router.chunk_caches(cx, cz);
+            let mut aquifer = crate::aquifer::for_settings(pos, &settings, &router, &caches);
+            let mut chunk = crate::fill::fill_chunk_with(
+                pos,
+                &settings,
+                &router,
+                biome_tree.as_ref(),
+                &caches,
+                aquifer.as_mut(),
+            );
+            crate::ore_veins::apply_ore_veins(&mut chunk, pos, &settings, &router, &caches);
+            let mut per_column = chunk.clone();
+            let mut system = SurfaceSystem::new(&settings, &router, &temperatures);
+            assert!(system.preliminary_per_quart);
+            system.apply(&mut chunk, pos, &caches);
+            let mut system = SurfaceSystem::new(&settings, &router, &temperatures);
+            system.preliminary_per_quart = false;
+            system.apply(&mut per_column, pos, &caches);
+            for (a, b) in chunk.sections.iter().zip(&per_column.sections) {
+                for slot in 0..SECTION_SLOTS {
+                    assert_eq!(a.block_states.get(slot), b.block_states.get(slot));
+                }
+            }
+        }
+    }
 }

+/// Whether `preliminary_surface_level`, sampled through chunk caches, gives at every block
+/// column `(x, 0, z)` exactly the bits it gives at the quart origin `(x & !3, 0, z & !3)`:
+/// [`NoiseRouterEvaluator::is_quart_invariant`], proven on the compiled program in
+/// `oxide-noise`. The surface pass always samples at y 0, so quart invariance alone is enough.
+/// Conservative: a router it cannot prove keeps the 256 samples per chunk.
+///
+/// `SurfaceSystem::new` runs once per chunk, so the answer is kept per thread, per router id
+/// (which no two evaluators in a process share).
+fn preliminary_snaps_to_quart(router: &NoiseRouterEvaluator) -> bool {
+    thread_local! {
+        static PROVEN: std::cell::RefCell<Vec<(u64, bool)>> =
+            const { std::cell::RefCell::new(Vec::new()) };
+    }
+    PROVEN.with(|proven| {
+        let mut proven = proven.borrow_mut();
+        if let Some((_, answer)) = proven.iter().find(|(id, _)| *id == router.id()) {
+            return *answer;
+        }
+        let answer = prove_preliminary_snaps_to_quart(router);
+        proven.push((router.id(), answer));
+        answer
+    })
+}
+
+fn prove_preliminary_snaps_to_quart(router: &NoiseRouterEvaluator) -> bool {
+    router.is_quart_invariant(RouterSlot::PreliminarySurfaceLevel)
+}

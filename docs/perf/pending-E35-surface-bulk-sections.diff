+/// What one below-surface band's program does for one chunk biome (see
+/// [`SurfaceSystem::below_shapes`]).
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum BandShape {
+    /// The folded program has no ops left: it places nothing, whatever the position.
+    Empty,
+    /// Its first op is this `block`: it places this result without testing anything.
+    Const(usize),
+    /// Evaluated as usual.
+    Eval,
+}
+
+/// Whether `condition` reads the state the column walk carries down a run of ground:
+/// `stone_depth_above`, `stone_depth_below` or `water_height`.
+fn reads_run_state(condition: &CompiledCondition<'_>) -> bool {
+    match condition {
+        CompiledCondition::StoneDepth { .. } | CompiledCondition::Water { .. } => true,
+        CompiledCondition::YAbove {
+            add_stone_depth, ..
+        } => *add_stone_depth,
+        CompiledCondition::Not(inner) => reads_run_state(inner),
+        CompiledCondition::Biome(_)
+        | CompiledCondition::Noise2d { .. }
+        | CompiledCondition::Noise3d { .. }
+        | CompiledCondition::VerticalGradient { .. }
+        | CompiledCondition::Temperature
+        | CompiledCondition::Steep { .. }
+        | CompiledCondition::Hole
+        | CompiledCondition::AbovePreliminarySurface => false,
+    }
+}

+/// Vanilla's `OreVeinifier` filler at one position, given `vein_toggle` there.
+fn vein_state(
+    router: &NoiseRouterEvaluator,
+    caches: &ChunkCaches,
+    ore_factory: &oxide_noise::WorldPositionalFactory,
+    x: i32,
+    y: i32,
+    z: i32,
+    veininess: f64,
+) -> Option<&'static str> {

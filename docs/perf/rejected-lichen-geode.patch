     let d = |from: i32, to: i32| f64::from(from) - f64::from(to);
@@ -150,6 +156,60 @@ impl GeodeFeature {
         }
     }
 
+    /// [`Self::safe_set`] for a state interned as `id`, with the `cannot_replace` test answered
+    /// once per distinct state in `cache`. Outside the window the write is refused either way.
+    fn safe_set_id(
+        &self,
+        cx: &mut FeatureContext<'_, '_, '_>,
+        pos: BlockPos,
+        id: u32,
+        cache: &mut ReplaceCache,
+    ) {
+        let blocked = 'blocked: {
+            let Some((key, state)) = cx.region.block_keyed(pos) else {
+                // As `safe_set` reads it; `set_block_id` refuses outside the window.
+                break 'blocked self
+                    .cannot_replace
+                    .contains_block(cx.env, &block_in(cx.region, pos).name);
+            };
+            let slot = &mut cache.0[key.slot() & (REPLACE_SLOTS - 1)];
+            match *slot {
+                Some((cached, answer)) if cached == key => answer,
+                _ => {
+                    let answer = self.cannot_replace.contains_block(cx.env, &state.name);
+                    *slot = Some((key, answer));
+                    answer
+                }
+            }
+        };
+        if !blocked {
+            cx.region.set_block_id(pos, id);
+        }
+    }
+
+    /// Writes `provider`'s state at `pos` as `safe_set` would; `false` when the provider gave
+    /// none (tallied). A simple provider draws nothing, so its state is interned once into
+    /// `id` and written by id.
+    fn place_layer(
+        &self,
+        cx: &mut FeatureContext<'_, '_, '_>,
+        provider: &StateProvider,
+        id: &mut Option<u32>,
+        pos: BlockPos,
+        cache: &mut ReplaceCache,
+    ) -> bool {
+        if let StateProvider::Simple(state) = provider {
+            let id = *id.get_or_insert_with(|| cx.region.intern(state));
+            self.safe_set_id(cx, pos, id, cache);
+            return true;
+        }
+        let Some(state) = Self::sample(cx, provider, pos) else {
+            return false;
+        };
+        self.safe_set(cx, pos, state);
+        true
+    }
+
     /// The provider's state at `pos`; a provider that cannot give one is tallied.
     fn sample(
         cx: &mut FeatureContext<'_, '_, '_>,
@@ -221,6 +281,10 @@ impl GeodeFeature {
             }

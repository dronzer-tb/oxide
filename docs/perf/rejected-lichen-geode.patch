         let (low, high) = (self.min_gen_offset, self.max_gen_offset);
         // `BlockPos.betweenClosed` walks x fastest, then y, then z.
         for dz in low..=high {
@@ -239,10 +303,9 @@ impl GeodeFeature {
                         continue;

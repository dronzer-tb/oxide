+    /// Whether the block at `pos` is air or water (and, with `or_block`, this feature's own
+    /// block): one read for what `is_air`, `block_in` and the name tests would each look up.
+    fn open_at(&self, cx: &FeatureContext<'_, '_, '_>, pos: BlockPos, or_block: bool) -> bool {
+        match cx.region.probe(pos) {
+            Some(probe) => {
+                probe.is(BlockFact::Air)
+                    || self.is_water(probe.state)
+                    || (or_block && self.is_block(probe.state))
+            }
+            None => {
+                let state = block_in(cx.region, pos);
+                self.air_or_water(cx, pos) || (or_block && self.is_block(state))
+            }
+        }
+    }
+
+    /// Whether the block at `pos` is in `can_be_placed_on`, answered once per distinct state
+    /// within one placement.
+    fn placeable_on(
+        &self,
+        cx: &FeatureContext<'_, '_, '_>,
+        pos: BlockPos,
+        cache: &mut PlaceableCache,
+    ) -> bool {
+        match cx.region.block_keyed(pos) {
+            Some((key, state)) => {
+                let slot = &mut cache.0[key.slot() & (PLACEABLE_SLOTS - 1)];
+                if let Some((cached, answer)) = *slot {
+                    if cached == key {
+                        return answer;
+                    }
+                }
+                let answer = self.can_be_placed_on.contains_block(cx.env, &state.name);
+                *slot = Some((key, answer));
+                answer
+            }
+            None => self
+                .can_be_placed_on
+                .contains_block(cx.env, &block_in(cx.region, pos).name),
+        }
+    }
+

+/// Per `place` call: the ground state's interned id once written, and per existing state key
+/// whether it has the ground's name and whether `replaceable` holds for it.
+#[derive(Default)]
+struct GroundCache {
+    id: Option<u32>,
+    slots: [Option<(StateKey, bool, bool)>; GROUND_SLOTS],
 }

+    pub fn is_local(&self) -> bool {
+        match self {
+            Self::True => true,
+            Self::Not(inner) => inner.is_local(),
+            Self::AllOf(list) | Self::AnyOf(list) => list.iter().all(Self::is_local),
+            Self::MatchingBlocks { offset, .. }

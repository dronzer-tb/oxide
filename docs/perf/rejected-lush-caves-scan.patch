+impl Probe<'_> {
+    /// Whether `fact` holds for the state, through the region's per-state fact cache.
+    #[inline]
+    pub fn is(&self, fact: BlockFact) -> bool {
+        self.cache.is(self.facts, self.state, fact)
+    }

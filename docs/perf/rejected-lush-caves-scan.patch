+            Self::MatchingBlocks { blocks, .. } => blocks.contains_block(env, &probe.state.name),
+            Self::MatchingBlockTag { tag, .. } => env.block_tags.contains(tag, &probe.state.name),
+            Self::MatchingFluids { fluids, .. } => {

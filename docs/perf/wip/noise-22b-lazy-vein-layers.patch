+/// Bit `slot` for each `interpolated` slot reached from `vein_toggle`, `vein_ridged` or
+/// `vein_gap` and from no other router slot. The ore-vein pass reads those only inside the vein
+/// bands, and `vein_ridged` only where `vein_toggle` allows a vein, so a whole corner grid is
+/// mostly wasted there; any slot another program also reaches keeps the whole-grid build.
+fn vein_only_interpolated_slots(programs: &[Program]) -> u64 {
+    let (mut vein, mut other) = (Vec::new(), Vec::new());
+    for (slot, program) in RouterSlot::ALL.iter().zip(programs) {
+        let is_vein = matches!(
+            slot,
+            RouterSlot::VeinToggle | RouterSlot::VeinRidged | RouterSlot::VeinGap
+        );
+        program.interpolated_slots(if is_vein { &mut vein } else { &mut other });
+    }
+    vein.iter()
+        .filter(|slot| **slot < 64 && !other.contains(slot))
+        .fold(0, |mask, slot| mask | 1 << slot)
+}

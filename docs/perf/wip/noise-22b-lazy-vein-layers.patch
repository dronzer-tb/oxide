+    /// Every `interpolated` cache slot this program can reach, through nested programs and
+    /// cache arguments too, appended to `out` (possibly more than once).
+    pub(crate) fn interpolated_slots(&self, out: &mut Vec<u32>) {
+        fn spline(s: &CompiledSpline, out: &mut Vec<u32>) {
+            s.coordinate.interpolated_slots(out);
+            for point in &s.points {
+                if let CompiledSplineValue::Spline(inner) = &point.value {
+                    spline(inner, out);
+                }
+            }
+        }
+        for op in &self.ops {
+            match op {
+                Op::Cache {
+                    kind,
+                    slot,
+                    argument,
+                } => {
+                    if *kind == CacheKind::Interpolated {
+                        out.push(*slot);
+                    }
+                    argument.interpolated_slots(out);
+                }
+                Op::RangeChoice(r) => {
+                    r.when_in_range.interpolated_slots(out);
+                    r.when_out_of_range.interpolated_slots(out);
+                }
+                Op::IntervalSelect(s) => {
+                    for function in &s.functions {
+                        function.interpolated_slots(out);
+                    }
+                }
+                Op::FindTopSurface(f) => f.density.interpolated_slots(out),
+                Op::GatedAdd(g) => g.body.interpolated_slots(out),
+                Op::Spline(s) => spline(s, out),
+                _ => {}
+            }
+        }
+    }

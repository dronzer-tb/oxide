+/// `GRADIENT` padded to four components (`[g0, g1, g2, 0.0]`) and 32-byte aligned, so each row
+/// is one aligned 32-byte block: its `[g0, g1]` and `[g2, pad]` halves are aligned 16-byte loads.
+/// The pad is never used in arithmetic. The table is 512 bytes and shared by every instance, so
+/// it stays in L1 (a per-instance 512-row table would be 16 KiB per octave).
+#[cfg(all(target_arch = "x86_64", target_feature = "avx"))]
+#[repr(C, align(32))]
+struct Grad4([[f64; 4]; 16]);
+
+#[cfg(all(target_arch = "x86_64", target_feature = "avx"))]
+static GRAD4: Grad4 = {
+    let mut rows = [[0.0f64; 4]; 16];
+    let mut n = 0;
+    while n < 16 {
+        rows[n] = [GRADIENT[n][0], GRADIENT[n][1], GRADIENT[n][2], 0.0];
+        n += 1;
+    }
+    Grad4(rows)
+};
+
+/// The 8 corner dot products and 7 lerps of one sample, four lanes wide (AVX).
+///
+/// Lanes pair corners that differ only in z, so after the x lerps the low half of the vector
+/// is `[e0, e2]` and the high half `[e1, e3]`, and the y lerps need only a 128-bit extract:
+///
+/// | vector | lanes | rows | x offset | y offsets | z offsets |
+/// |---|---|---|---|---|---|
+/// | `a` | d0, d4, d2, d6 | `k, k+1, l, l+1` | dx | dy, dy, dy-1, dy-1 | dz, dz-1, dz, dz-1 |
+/// | `b` | d1, d5, d3, d7 | `i1, i1+1, j1, j1+1` | dx-1 | (same) | (same) |
+///
+/// Each gradient row is loaded as two 16-byte halves (`[g0, g1]`, `[g2, pad]`); rows 0/2 and
+/// 1/3 share a 256-bit register (`vinsertf128` from memory), and in-lane unpacks give
+/// `gx, gy, gz` with no cross-lane shuffle (Zen 1 splits 256-bit ops into 128-bit halves, and
+/// lane-crossing permutes are its slow case).
+///
+/// Exactness: every lane does exactly the scalar IEEE operations on the scalar operands, in
+/// the scalar order, with no FMA (`_mm256_mul_pd`/`add`/`sub` and the `_mm_*` forms lower to
+/// plain `fmul`/`fadd`/`fsub`, which LLVM never contracts without fast-math flags):
+/// - `grad_dot`: `(g0 * x + g1 * y) + g2 * z`, with `g` the real gradient components (±1.0 or
+///   0.0, the same values as `GRADIENT`), so signed zeros come out as in the scalar products.
+///   The pad lane is loaded but never enters arithmetic.
+/// - `lerp(t, a, b) = a + t * (b - a)`: `e0..e3` from the x pairs, `f0 = lerp(u, e0, e1)`,
+///   `f1 = lerp(u, e2, e3)` from the halves, and the last z lerp in scalar code.
+/// - The offsets `dx - 1.0`, `dy - 1.0`, `dz - 1.0` are the same scalar subtractions as before.
+#[cfg(all(target_arch = "x86_64", target_feature = "avx"))]
+#[allow(clippy::too_many_arguments)]
+#[inline(always)]
+fn corners_and_lerp(
+    p: &[u8; 512],
+    k: usize,
+    l: usize,
+    i1: usize,
+    j1: usize,
+    dx: f64,
+    dy: f64,
+    dz: f64,
+    t: f64,
+    u: f64,
+    v: f64,
+) -> f64 {
+    use std::arch::x86_64::*;
+    // SAFETY: AVX is enabled for the build (`cfg` above). `row` points at one of `GRAD4`'s 16
+    // rows (index masked to 0..=15); each row is 32 bytes at a 32-byte-aligned address, so the
+    // 16-byte loads at offsets 0 and 2 are in bounds. The `p` indices are at most
+    // 255 + 255 + 1 = 511 (see `sample_and_lerp`), checked by the slice indexing.
+    unsafe {
+        let base = GRAD4.0.as_ptr() as *const f64;
+        let row = |n: usize| base.add(((p[n] & 15) as usize) * 4);
+
+        #[inline(always)]
+        unsafe fn dot4(r: [*const f64; 4], x: __m256d, y: __m256d, z: __m256d) -> __m256d {
+            let lo02 = _mm256_loadu2_m128d(r[2], r[0]);
+            let lo13 = _mm256_loadu2_m128d(r[3], r[1]);
+            let hi02 = _mm256_loadu2_m128d(r[2].add(2), r[0].add(2));
+            let hi13 = _mm256_loadu2_m128d(r[3].add(2), r[1].add(2));
+            let gx = _mm256_unpacklo_pd(lo02, lo13);
+            let gy = _mm256_unpackhi_pd(lo02, lo13);
+            let gz = _mm256_unpacklo_pd(hi02, hi13);
+            _mm256_add_pd(
+                _mm256_add_pd(_mm256_mul_pd(gx, x), _mm256_mul_pd(gy, y)),
+                _mm256_mul_pd(gz, z),

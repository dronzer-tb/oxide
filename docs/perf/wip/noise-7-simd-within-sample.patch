+        let dz1 = dz - 1.0;
+        let yv = _mm256_setr_pd(dy, dy, dy1, dy1);
+        let zv = _mm256_setr_pd(dz, dz1, dz, dz1);
+        let a = dot4(
+            [row(k), row(k + 1), row(l), row(l + 1)],
+            _mm256_set1_pd(dx),
+            yv,
+            zv,
+        ); // [d0, d4, d2, d6]
+        let b = dot4(
+            [row(i1), row(i1 + 1), row(j1), row(j1 + 1)],
+            _mm256_set1_pd(dx - 1.0),
+            yv,
+            zv,
+        ); // [d1, d5, d3, d7]
+        let e = _mm256_add_pd(a, _mm256_mul_pd(_mm256_set1_pd(t), _mm256_sub_pd(b, a)));
+        let e02 = _mm256_castpd256_pd128(e); // [e0, e2]
+        let e13 = _mm256_extractf128_pd::<1>(e); // [e1, e3]

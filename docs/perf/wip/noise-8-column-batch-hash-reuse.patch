+            limit_z[j] = zs[j] * xz_multiplier;
+            main_x[j] = limit_x[j] / params.xz_factor;
+            main_y[j] = limit_y[j] / params.y_factor;
+            main_z[j] = limit_z[j] / params.xz_factor;

+                ),
+                (
+                    "cache_2d over a y-dependent argument in the density",
+                    scan(
+                        upper_bound(0.0),
+                        obj(O::Add {
+                            argument1: surface_density(),
+                            argument2: obj(O::Cache2d {
+                                argument: gradient(),
+                            }),
+                        }),
+                    ),
+                ),
+                (
+                    "no scan at all",
+                    obj(O::Add {
+                        argument1: gradient(),
+                        argument2: factor(),
+                    }),
+                ),
+            ];
+            for (what, df) in cases {
+                let router = router_for(&settings_with(df));
+                assert!(!memoised(&router, slot), "{what}");
+                assert!(!router.programs[slot.index()].column_invariant(), "{what}");
+            }
+
+            // A y gradient upper bound genuinely moves with y: memoising it would be wrong.
+            let moving = obj(O::Mul {
+                argument1: DensityFunction::Constant(100.0),
+                argument2: gradient(),
+            });
+            let router = router_for(&settings_with(scan(moving, surface_density())));
+            let caches = router.chunk_caches(0, 0);
+            let low = router.sample_in_chunk(&caches, slot, 3, -64, 3);
+            let high = router.sample_in_chunk(&caches, slot, 3, 300, 3);
+            assert_ne!(low.to_bits(), high.to_bits());
+
+            // Sign-safe constant shift_y values are accepted.
+            for shift_y in [0.0, 2.0, f64::INFINITY] {
+                let router = router_for(&settings_with(scan(
+                    upper_bound(shift_y),
+                    surface_density(),
+                )));
+                assert!(memoised(&router, slot), "shift_y {shift_y}");
+            }
+
+            // Proven y- and cache-independent, but a cheap 2D lookup with no scan: not worth a
+            // lock, so left to the chunk's own 2D cache.
+            let router = router_for(&settings_with(scan(upper_bound(0.0), surface_density())));
+            let (invariant, memoised_slots) = router.column_invariant_slots();
+            assert!(invariant.contains(&"continents"));
+            assert!(!invariant.contains(&"final_density"));
+            assert_eq!(memoised_slots, vec!["preliminary_surface_level"]);
+        }
+    }
 }

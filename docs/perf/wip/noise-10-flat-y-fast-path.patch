+    #[test]
+    fn noise_2d_matches_current_bit_for_bit() {
+        use oxide_core::Xoroshiro128PlusPlus;
+        let mut rng = LegacyRandom::new(0x2d2d);
+        for seed in 0..256u64 {
+            let mut r = Xoroshiro128PlusPlus::new(seed as i64);
+            let noise = ImprovedNoise::new(&mut r);
+            assert!(noise.has_y2d);
+            let reference = reference::Ref {
+                permutation: &noise.permutation[..256],
+                xo: noise.xo,
+                yo: noise.yo,
+                zo: noise.zo,
+            };
+            for n in 0..2000 {
+                let x = hard_xz(&mut rng, n, noise.xo);
+                let z = hard_xz(&mut rng, n / 3 + n, noise.zo);
+                for &y in &[0.0f64, -0.0] {
+                    let fast = noise.noise_2d(x, y, z);
+                    let cur = current_noise_with_scale(&noise, x, y, z, 0.0, 0.0);
+                    let gen = noise.noise_with_scale(x, y, z, 0.0, 0.0);
+                    let old = reference.noise_with_scale(x, y, z, 0.0, 0.0);
+                    assert_eq!(fast.to_bits(), cur.to_bits(), "seed {seed} ({x}, {y}, {z})");
+                    assert_eq!(gen.to_bits(), cur.to_bits(), "seed {seed} ({x}, {y}, {z})");
+                    assert_eq!(old.to_bits(), cur.to_bits(), "seed {seed} ({x}, {y}, {z})");
+                }
+            }
+        }
+    }
+
+    /// `dx` (and `dz`) round to exactly 1.0 when `d0` is a tiny negative: `-tiny - (-1) == 1.0`.
+    /// That needs a tiny `xo`, so force one; `dx - 1.0` is then `+0.0`.
+    #[test]
+    fn noise_2d_matches_current_when_dx_is_one() {
+        use oxide_core::Xoroshiro128PlusPlus;
+        let mut seen = 0;
+        for seed in 0..32u64 {
+            let mut r = Xoroshiro128PlusPlus::new(seed as i64);
+            let mut noise = ImprovedNoise::new(&mut r);
+            for &off in &[0.0f64, 1.0e-20, -3.0e-18, 2f64.powi(-60)] {
+                noise.xo = off;
+                noise.zo = off;
+                for &x in &[-1.0e-300, -1.0e-20, -2f64.powi(-54), -2f64.powi(-55), -1.0e-17] {
+                    let x = x - off;
+                    let d0 = x + noise.xo;
+                    if d0 - d0.floor() == 1.0 {
+                        seen += 1;
+                    }
+                    for &z in &[x, 0.5, -0.0] {
+                        for &y in &[0.0f64, -0.0] {
+                            let a = noise.noise_2d(x, y, z);
+                            let b = current_noise_with_scale(&noise, x, y, z, 0.0, 0.0);
+                            assert_eq!(a.to_bits(), b.to_bits(), "({x}, {y}, {z})");
+                        }
+                    }
+                }
+            }
+        }
+        assert!(seen > 0, "no sample hit dx == 1.0");
+    }

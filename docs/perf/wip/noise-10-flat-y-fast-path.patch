+    /// Copy of `noise_with_scale` as it stood before the 2D path (doubled table, per-sample y).
+    fn current_noise_with_scale(
+        n: &ImprovedNoise,
+        x: f64,
+        y: f64,
+        z: f64,
+        y_scale: f64,
+        y_max: f64,
+    ) -> f64 {
+        let d0 = x + n.xo;
+        let d1 = y + n.yo;
+        let d2 = z + n.zo;
+        let i = d0.floor() as i32;
+        let j = d1.floor() as i32;
+        let k = d2.floor() as i32;
+        let dx = d0 - i as f64;
+        let dy = d1 - j as f64;
+        let dz = d2 - k as f64;
+        let dy_faded = if y_scale != 0.0 {
+            let clamped = if y_max >= 0.0 && y_max < dy {
+                y_max
+            } else {
+                dy
+            };
+            (clamped / y_scale + 1.0e-7).floor() * y_scale
+        } else {
+            0.0
+        };
+        let (dy, fade_dy) = (dy - dy_faded, dy);
+        let p = &n.permutation;
+        let xm = (i & 255) as usize;
+        let ym = (j & 255) as usize;
+        let zm = (k & 255) as usize;
+        let a = p[xm] as usize + ym;
+        let b = p[xm + 1] as usize + ym;
+        let k = p[a] as usize + zm;
+        let l = p[a + 1] as usize + zm;
+        let i1 = p[b] as usize + zm;
+        let j1 = p[b + 1] as usize + zm;
+        let d0 = grad_dot(p[k], dx, dy, dz);
+        let d1 = grad_dot(p[i1], dx - 1.0, dy, dz);
+        let d2 = grad_dot(p[l], dx, dy - 1.0, dz);
+        let d3 = grad_dot(p[j1], dx - 1.0, dy - 1.0, dz);
+        let d4 = grad_dot(p[k + 1], dx, dy, dz - 1.0);
+        let d5 = grad_dot(p[i1 + 1], dx - 1.0, dy, dz - 1.0);
+        let d6 = grad_dot(p[l + 1], dx, dy - 1.0, dz - 1.0);
+        let d7 = grad_dot(p[j1 + 1], dx - 1.0, dy - 1.0, dz - 1.0);
+        let t = smoothstep(dx);
+        let u = smoothstep(fade_dy);
+        let v = smoothstep(dz);
+        let e0 = lerp(t, d0, d1);
+        let e1 = lerp(t, d2, d3);
+        let e2 = lerp(t, d4, d5);
+        let e3 = lerp(t, d6, d7);
+        let f0 = lerp(u, e0, e1);
+        let f1 = lerp(u, e2, e3);
+        lerp(v, f0, f1)
+    }
+
+    /// x/z inputs that stress the 2D path: negatives, huge (wrapped and unwrapped), near
+    /// integers, and values whose fractional part rounds `dx` to exactly 1.0.
+    pub(crate) fn hard_xz(rng: &mut LegacyRandom, n: usize, xo: f64) -> f64 {
+        let scales = [1.0, 1.0e3, 1.0e6, 3.0e7, 1.0e9, 3.0e9];
+        match n % 8 {
+            0..=3 => (rng.next_double() * 2.0 - 1.0) * scales[n % scales.len()],
+            4 => wrap((rng.next_double() * 2.0 - 1.0) * 1.0e10),
+            5 => {
+                let base = (rng.next_int_bounded(2000) - 1000) as f64;
+                base + (rng.next_double() - 0.5) * 1.0e-12
+            }
+            // d0 = x + xo exactly on the lattice (0.0), or one ulp either side of it.
+            6 => match rng.next_int_bounded(3) {
+                0 => -xo,
+                1 => f64::from_bits((-xo).to_bits() + 1),
+                _ => f64::from_bits((-xo).to_bits() - 1),
+            },
+            _ => -(rng.next_int_bounded(1000) as f64) - xo,
+        }
+    }

+impl BlendedNoise {
+    /// [`Self::compute`] at every `(xs[i], ys[i], zs[i])`, bit-identical per lane: the same
+    /// per-lane expressions in the same octave order, with each octave's lanes in an inner loop.
+    pub fn compute_lanes(
+        &self,
+        params: &BlendedNoiseParams,
+        xs: &[f64],
+        ys: &[f64],
+        zs: &[f64],
+        out: &mut [f64],
+    ) {
+        let k = out.len();
+        let xz_multiplier = 684.412 * params.xz_scale;
+        let y_multiplier = 684.412 * params.y_scale;
+        let limit_x: Vec<f64> = xs.iter().map(|x| x * xz_multiplier).collect();
+        let limit_y: Vec<f64> = ys.iter().map(|y| y * y_multiplier).collect();
+        let limit_z: Vec<f64> = zs.iter().map(|z| z * xz_multiplier).collect();
+        let main_x: Vec<f64> = limit_x.iter().map(|x| x / params.xz_factor).collect();
+        let main_y: Vec<f64> = limit_y.iter().map(|y| y / params.y_factor).collect();
+        let main_z: Vec<f64> = limit_z.iter().map(|z| z / params.xz_factor).collect();
+        let limit_smear = y_multiplier * params.smear_scale_multiplier;
+        let main_smear = limit_smear / params.y_factor;
+
+        let mut main_value = vec![0.0f64; k];
+        let mut pow = 1.0;
+        for i in 0..8 {
+            if let Some(noise) = self.main.get_octave_noise(i) {
+                for j in 0..k {
+                    main_value[j] += noise.noise_with_scale(
+                        wrap(main_x[j] * pow),
+                        wrap(main_y[j] * pow),
+                        wrap(main_z[j] * pow),
+                        main_smear * pow,
+                        main_y[j] * pow,
+                    ) / pow;
+                }
+            }
+            pow /= 2.0;
+        }
+
+        let factor: Vec<f64> = main_value.iter().map(|v| (v / 10.0 + 1.0) / 2.0).collect();
+        let mut blend_min = vec![0.0f64; k];
+        let mut blend_max = vec![0.0f64; k];
+        pow = 1.0;
+        for i in 0..16 {
+            let y_scale_pow = limit_smear * pow;
+            let min_noise = self.min_limit.get_octave_noise(i);
+            let max_noise = self.max_limit.get_octave_noise(i);
+            for j in 0..k {
+                let wx = wrap(limit_x[j] * pow);
+                let wy = wrap(limit_y[j] * pow);
+                let wz = wrap(limit_z[j] * pow);
+                // Negated as the scalar path tests them, so a NaN factor behaves the same.
+                if !(factor[j] >= 1.0) {
+                    if let Some(noise) = min_noise {
+                        blend_min[j] +=
+                            noise.noise_with_scale(wx, wy, wz, y_scale_pow, limit_y[j] * pow) / pow;
+                    }
+                }
+                if !(factor[j] <= 0.0) {
+                    if let Some(noise) = max_noise {
+                        blend_max[j] +=
+                            noise.noise_with_scale(wx, wy, wz, y_scale_pow, limit_y[j] * pow) / pow;
+                    }
+                }
+            }
+            pow /= 2.0;
+        }
+
+        for j in 0..k {
+            out[j] = clamped_lerp(factor[j], blend_min[j] / 512.0, blend_max[j] / 512.0) / 128.0;
+        }
+    }
+}

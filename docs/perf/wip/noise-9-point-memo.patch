+/// A last-position memo per cache node, for sampling *without* chunk caches
+/// ([`crate::NoiseRouterEvaluator::sample_with_memo`]). Every `interpolated`, `cache_2d`,
+/// `flat_cache` and `cache_once` node remembers the last exact position its argument ran at
+/// and the value it gave there.
+///
+/// Exact, with no condition on the program: with no chunk caches a cache node's value is its
+/// argument run at the caller's exact `ctx` (no quart snapping, no cell blend), and that run is
+/// a deterministic function of `ctx` -- it reads only `ctx`, the router's seeded noises and,
+/// through nested cache nodes, this same memo, which by induction returns what the nested
+/// argument would compute. Two nodes share a slot only when their kind group and argument
+/// fingerprint (a full structural serialisation) are equal, so whichever node or router slot
+/// stored an entry computed it with an identical argument. A hit therefore returns the very
+/// bits a straight-through evaluation would produce, signed zeros and NaN payloads included.
+///
+/// What it saves: the uncached overworld `depth` re-runs its spline coordinates (`erosion`,
+/// `ridges`) once per nested spline it visits, and every 2D climate noise re-runs the same
+/// `shift_a`/`shift_b` offsets; sampling `erosion` and then `depth` at one position also runs
+/// `erosion` twice. Each of those becomes one evaluation per position.
+///
+/// Bound to the router that made it (see [`crate::NoiseRouterEvaluator::point_memo`]); slot
+/// numbers mean nothing to another router.
+pub struct PointMemo {
+    pub(crate) router_id: u64,
+    interpolated: RefCell<Vec<Option<LastSample>>>,
+    two_d: RefCell<Vec<Option<LastSample>>>,
+    once: RefCell<Vec<Option<LastSample>>>,
+}
+
+impl PointMemo {
+    pub(crate) fn new(router_id: u64, slots: CacheSlotCounts) -> Self {
+        Self {
+            router_id,
+            interpolated: RefCell::new(vec![None; slots.interpolated]),
+            two_d: RefCell::new(vec![None; slots.two_d]),
+            once: RefCell::new(vec![None; slots.once]),
+        }
+    }
+
+    /// The value of the cache node `(kind, slot)` at `ctx` with no chunk caches: `argument` run
+    /// at exactly `ctx`, or the remembered bits of that same run.
+    pub(crate) fn get_or_run(
+        &self,
+        kind: CacheKind,
+        slot: usize,
+        argument: &Program,
+        ctx: FunctionContext,
+        cx: &RunCtx,
+    ) -> f64 {
+        // `cache_2d` and `flat_cache` number their slots from one shared counter, as in
+        // `ChunkCaches`, so one table serves both.
+        let table = match kind {
+            CacheKind::Interpolated => &self.interpolated,
+            CacheKind::Cache2d | CacheKind::FlatCache => &self.two_d,
+            CacheKind::Once => &self.once,
+        };
+        let position = (ctx.x, ctx.y, ctx.z);
+        if let Some(Some((cached_position, value))) = table.borrow().get(slot) {
+            if *cached_position == position {
+                return *value;
+            }
+        }
+        // Not held across the run below, which may consult this same memo.
+        let value = argument.run(ctx, cx);
+        if let Some(entry) = table.borrow_mut().get_mut(slot) {
+            *entry = Some((position, value));
+        }
+        value
+    }
+
+    /// Entries holding a value, for tests that check the memo was exercised.
+    #[cfg(test)]
+    pub(crate) fn filled(&self) -> usize {
+        [&self.interpolated, &self.two_d, &self.once]
+            .iter()
+            .map(|t| t.borrow().iter().filter(|e| e.is_some()).count())
+            .sum()
+    }
+}
+
 /// Ways per set in [`CornerColumns`].
 const COLUMN_WAYS: usize = 4;
 /// Independently locked shards of [`CornerColumns`].

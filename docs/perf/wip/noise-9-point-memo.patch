+    /// An overworld-shaped router for the point memo: `erosion` a `flat_cache`d 2D shifted noise,
+    /// `depth` a y gradient plus a `flat_cache(cache_2d(spline))` offset whose spline nests
+    /// continents -> erosion -> ridges (so the coordinates are re-read per nested spline), every
+    /// climate noise over the same cached `shift_a`/`shift_b`. `final_density` adds the cases the
+    /// overworld aquifer does not reach: `cache_once`, `interpolated` over 3D noise, and a 2D
+    /// shifted noise with a `-0.0` `shift_y` (whose noise input keeps the sign of y).
+    fn point_memo_settings(
+    ) -> (NoiseGeneratorSettings, Registry<oxide_datapack::NormalNoiseParameters>) {
+        use oxide_datapack::{
+            CubicSpline, DensityFunctionObject as O, NormalNoiseParameters, SplinePoint,
+            SplineValue,
+        };
+        fn obj(o: O) -> DensityFunction {
+            DensityFunction::Object(Box::new(o))
+        }
+        let rl = |id: &str| Rl::new("minecraft", id);
+        let ids = ["continents", "erosion", "ridges", "offset", "barrier", "cave"];
+        let noises: Registry<NormalNoiseParameters> = ids
+            .iter()
+            .enumerate()
+            .map(|(i, id)| {
+                let params = NormalNoiseParameters {
+                    first_octave: -7 - i as i32,
+                    amplitudes: vec![1.0, 1.0, 0.5, 0.0, 1.0],
+                };
+                (rl(id), params)
+            })
+            .collect();
+        let shift = |o: O| obj(O::FlatCache { argument: obj(O::Cache2d { argument: obj(o) }) });
+        let climate = |id: &str, shift_y: f64| {
+            obj(O::FlatCache {
+                argument: obj(O::ShiftedNoise {
+                    noise: rl(id),
+                    xz_scale: 0.25,
+                    y_scale: 0.0,
+                    shift_x: shift(O::ShiftA { argument: rl("offset") }),
+                    shift_y: DensityFunction::Constant(shift_y),
+                    shift_z: shift(O::ShiftB { argument: rl("offset") }),
+                }),
+            })
+        };
+        let point = |location: f32, value: SplineValue, derivative: f32| SplinePoint {
+            location,
+            value,
+            derivative,
+        };
+        let ridges_spline = |k: f32| {
+            SplineValue::Spline(Box::new(CubicSpline {
+                coordinate: climate("ridges", 0.0),
+                points: vec![
+                    point(-1.0, SplineValue::Constant(-0.2 * k), 0.0),
+                    point(-0.3, SplineValue::Constant(0.1 * k), 0.4),
+                    point(0.4, SplineValue::Constant(0.3), -0.1 * k),
+                    point(1.0, SplineValue::Constant(0.05 * k), 0.0),
+                ],
+            }))
+        };
+        let erosion_spline = |k: f32| {
+            SplineValue::Spline(Box::new(CubicSpline {
+                coordinate: climate("erosion", 0.0),
+                points: vec![
+                    point(-0.8, ridges_spline(k), 0.0),
+                    point(-0.2, ridges_spline(k * 0.5), 0.2),
+                    point(0.3, ridges_spline(-k), 0.0),
+                    point(0.9, SplineValue::Constant(0.0), 0.0),
+                ],
+            }))
+        };
+        let offset = obj(O::FlatCache {
+            argument: obj(O::Cache2d {
+                argument: obj(O::Spline {
+                    spline: CubicSpline {
+                        coordinate: climate("continents", 0.0),
+                        points: vec![
+                            point(-1.1, SplineValue::Constant(0.04), 0.0),
+                            point(-0.4, erosion_spline(1.0), 0.0),
+                            point(0.0, erosion_spline(2.0), 0.1),
+                            point(0.5, erosion_spline(-1.5), 0.0),
+                        ],
+                    },
+                }),
+            }),
+        });
+        let depth = obj(O::Add {
+            argument1: obj(O::YClampedGradient {
+                from_y: -64,
+                to_y: 320,
+                from_value: 1.5,
+                to_value: -1.5,
+            }),
+            argument2: offset.clone(),
+        });
+
+        let mut settings = minimal_settings();
+        let router = &mut settings.noise_router;
+        router.continents = climate("continents", 0.0);
+        router.erosion = climate("erosion", 0.0);
+        router.ridges = climate("ridges", 0.0);
+        router.depth = depth.clone();
+        router.barrier = obj(O::Noise {
+            noise: rl("barrier"),
+            xz_scale: 1.0,
+            y_scale: 0.5,
+        });
+        router.final_density = obj(O::CacheOnce {
+            argument: obj(O::Add {
+                argument1: obj(O::Mul {
+                    argument1: depth,
+                    argument2: obj(O::Interpolated {
+                        argument: obj(O::Noise {
+                            noise: rl("cave"),
+                            xz_scale: 0.5,
+                            y_scale: 1.0,
+                        }),
+                    }),
+                }),
+                argument2: obj(O::Add {
+                    argument1: climate("cave", -0.0),
+                    argument2: obj(O::CacheOnce { argument: offset }),
+                }),
+            }),
+        });
+        (settings, noises)
+    }
+
+    /// `sample_with_memo` returns `sample`'s exact bits for every slot, whatever order the slots
+    /// and positions come in, with one memo reused throughout.
+    #[test]
+    fn point_memo_is_bit_identical_to_sample() {
+        let (settings, noises) = point_memo_settings();
+        let router = NoiseRouterEvaluator::new(31, &settings, &Registry::default(), &noises);
+        let memo = router.point_memo();
+        let slots = [
+            RouterSlot::Erosion,
+            RouterSlot::Depth,
+            RouterSlot::FinalDensity,
+            RouterSlot::Continents,
+            RouterSlot::Barrier,
+            RouterSlot::Ridges,
+        ];
+        let mut checked = 0;
+        for z in (-700i32..700).step_by(53) {
+            for x in (-900i32..900).step_by(37) {
+                for y in [-64i32, -9, -1, 0, 1, 40, 63, 200, 319] {
+                    for i in 0..slots.len() {
+                        // Rotate the slot order per position, and revisit Depth, so hits come
+                        // from the same slot, from another slot, and from an earlier position.
+                        let slot = slots[(i + (x + z + y).rem_euclid(6) as usize) % slots.len()];
+                        for s in [slot, RouterSlot::Depth] {
+                            let expected = router.sample(s, x, y, z);
+                            let got = router.sample_with_memo(&memo, s, x, y, z);
+                            assert_eq!(got.to_bits(), expected.to_bits(), "{s:?} at {x} {y} {z}");
+                            checked += 1;
+                        }
+                    }
+                }
+            }
+        }
+        assert!(checked > 30_000, "{checked}");
+        assert!(memo.filled() > 4, "the memo must have been used: {}", memo.filled());
+    }
+
+    /// The aquifer's pattern -- erosion then depth at a position, never the same position twice --
+    /// and a memo from another router, which must be ignored rather than read.
+    #[test]
+    fn point_memo_aquifer_pattern_and_foreign_memo() {
+        let (settings, noises) = point_memo_settings();
+        let router = NoiseRouterEvaluator::new(31, &settings, &Registry::default(), &noises);
+        let other = NoiseRouterEvaluator::new(32, &settings, &Registry::default(), &noises);
+        let memo = router.point_memo();
+        let foreign = other.point_memo();
+        let mut state = 0x9e37_79b9_7f4a_7c15u64;
+        for _ in 0..20_000 {
+            state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            let x = (state >> 40) as i32 % 3000 - 1500;
+            let z = (state >> 20) as i32 % 3000 - 1500;
+            let y = (state >> 8) as i32 % 384 - 64;
+            for slot in [RouterSlot::Erosion, RouterSlot::Depth] {
+                let expected = router.sample(slot, x, y, z).to_bits();
+                let got = router.sample_with_memo(&memo, slot, x, y, z).to_bits();
+                assert_eq!(got, expected, "{slot:?} {x} {y} {z}");
+                // Seed 32's memo, warmed at this position by its own router, must not leak in.
+                other.sample_with_memo(&foreign, slot, x, y, z);
+                let got = router.sample_with_memo(&foreign, slot, x, y, z).to_bits();
+                assert_eq!(got, expected, "foreign {slot:?}");
+            }
+        }
+    }
+
     /// The y-independence predicate accepts the vanilla climate shape (a 2D `shifted_noise`
     /// over `shift_a`/`shift_b` through 2D caches) and rejects every shape where y can leak in.
     /// Where it says yes, the values are bit-identical at every y.

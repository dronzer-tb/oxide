+    /// The column path (`column_xz` once, `sample_y` per lane) gives exactly
+    /// `noise_with_scale`'s bits along 49-lane columns, across lattice cells, for negative,
+    /// near-integer and wrapped-large x/z, with and without y-smear. The cell reuse must
+    /// actually happen.
+    #[test]
+    fn column_path_is_bit_identical_along_columns() {
+        use oxide_core::Xoroshiro128PlusPlus;
+        let before = hash_stats::local();
+        let xzs = [
+            (0.0, 0.0),
+            (-0.0, 5.5),
+            (-37.25, 211.75),
+            (1.0e-300, -1.0e-300),
+            (3.0e7, -2.9e7),
+            (-123.999999999, 64.000000001),
+        ];
+        // (y step, y_scale, y_max shape): plain, and blended-style smear.
+        let modes: [(f64, f64, f64); 3] =
+            [(0.37, 0.0, 0.0), (85.55, 684.412, 1.0), (0.021, 0.85, -1.0)];
+        for seed in 0..32u64 {
+            let mut r = Xoroshiro128PlusPlus::new(seed as i64 * 7919 + 3);
+            let noise = ImprovedNoise::new(&mut r);
+            for &(x, z) in &xzs {
+                for &(step, y_scale, y_max_sign) in &modes {
+                    let col = noise.column_xz(x, z);
+                    let mut cell = noise.column_cell(&col, HashKind::Perlin);
+                    for lane in 0..49 {
+                        let y = -64.0 * step + lane as f64 * step;
+                        let y_max = if y_max_sign >= 0.0 { y * 0.5 } else { -1.0 };
+                        let want = noise.noise_with_scale(x, y, z, y_scale, y_max);
+                        let got = noise.sample_y(&col, y, y_scale, y_max, &mut cell);
+                        assert_eq!(
+                            got.to_bits(),
+                            want.to_bits(),
+                            "seed {seed} at {x} {y} {z} mode {step}"
+                        );
+                    }
+                }
+            }
+        }
+        let after = hash_stats::local();
+        assert!(
+            after[0] - before[0] > 1000,
+            "cells were reused: {:?} -> {:?}",
+            before,
+            after
+        );
+        assert!(
+            after[1] - before[1] > 1000,
+            "cells were crossed: {:?} -> {:?}",
+            before,
+            after
+        );
+    }
+

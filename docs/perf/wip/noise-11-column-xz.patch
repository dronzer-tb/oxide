+/// The x/z half of a sample at one fixed (x, z) for one instance: everything
+/// [`ImprovedNoise::noise_with_scale`] computes from `x` and `z` alone, computed once per
+/// column instead of once per lane. See [`ImprovedNoise::sample_y`].
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct ColumnXZ {
+    i: i32,
+    k: i32,
+    dx: f64,
+    dz: f64,
+    dx1: f64,
+    dz1: f64,
+    t: f64,
+    v: f64,
+}
+
+/// One lattice cell of a column, with everything about its eight corners that does not depend
+/// on y: the hashes, and each corner's `g0 * xc` and `g2 * zc` products and `g1`.
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct ColumnCell {
+    j: i32,
+    a: [f64; 8],
+    g1: [f64; 8],
+    c: [f64; 8],
+    #[cfg(any(test, feature = "hash-stats"))]
+    kind: HashKind,
+}
+
+impl ImprovedNoise {
+    /// The x/z half of a sample at `(x, z)`: the same expressions `noise_with_scale` evaluates
+    /// for them, in the same order. `x` and `z` are the already-wrapped octave coordinates.
+    #[inline]
+    pub(crate) fn column_xz(&self, x: f64, z: f64) -> ColumnXZ {
+        let d0 = x + self.xo;
+        let d2 = z + self.zo;
+        let i = d0.floor() as i32;
+        let k = d2.floor() as i32;
+        let dx = d0 - i as f64;
+        let dz = d2 - k as f64;
+        ColumnXZ {
+            i,
+            k,
+            dx,
+            dz,
+            dx1: dx - 1.0,
+            dz1: dz - 1.0,
+            t: smoothstep(dx),
+            v: smoothstep(dz),
+        }
+    }
+
+    /// A [`ColumnCell`] for `col`, primed with a real cell so it is always consistent.
+    #[inline]
+    pub(crate) fn column_cell(&self, col: &ColumnXZ, kind: HashKind) -> ColumnCell {
+        let _ = kind;
+        let mut cell = ColumnCell {
+            j: i32::MIN,
+            a: [0.0; 8],
+            g1: [0.0; 8],
+            c: [0.0; 8],
+            #[cfg(any(test, feature = "hash-stats"))]
+            kind,
+        };
+        self.fill_column_cell(col, i32::MIN, &mut cell);
+        cell
+    }
+
+    /// Corner order as [`lerp_corners`]: d0..d7 = (x, y, z), (x-1, y, z), (x, y-1, z),
+    /// (x-1, y-1, z), then the same four at z-1.
+    #[inline(always)]
+    fn fill_column_cell(&self, col: &ColumnXZ, j: i32, cell: &mut ColumnCell) {
+        let h = self.corner_hashes(col.i, j, col.k);
+        let xc = [
+            col.dx, col.dx1, col.dx, col.dx1, col.dx, col.dx1, col.dx, col.dx1,
+        ];
+        let zc = [
+            col.dz, col.dz, col.dz, col.dz, col.dz1, col.dz1, col.dz1, col.dz1,
+        ];
+        for n in 0..8 {
+            let g = GRADIENT[(h[n] & 15) as usize];
+            cell.a[n] = g[0] * xc[n];
+            cell.g1[n] = g[1];
+            cell.c[n] = g[2] * zc[n];
+        }
+        cell.j = j;
+    }
+
+    /// [`Self::noise_with_scale`] at `(x, y, z)` where `col` is [`Self::column_xz`] of this
+    /// instance at that sample's `x` and `z`, reusing `cell` while consecutive samples of the
+    /// column stay in one lattice cell.
+    ///
+    /// Bit-identical to `noise_with_scale`: the y half is the same expressions; each corner's dot
+    /// product `g0*x + g1*y + g2*z` is evaluated by Rust as `(g0*x + g1*y) + g2*z`, and here as
+    /// `(A + g1*y) + C` with `A = g0*x` and `C = g2*z` the same IEEE products computed earlier;
+    /// the fades and the seven lerps are `lerp_corners`' own, with `t` and `v` from `col`.
+    #[inline]
+    pub(crate) fn sample_y(
+        &self,
+        col: &ColumnXZ,
+        y: f64,
+        y_scale: f64,
+        y_max: f64,
+        cell: &mut ColumnCell,
+    ) -> f64 {
+        let d1 = y + self.yo;
+        let j = d1.floor() as i32;
+        let dy = d1 - j as f64;
+        let dy_faded = if y_scale != 0.0 {
+            let clamped = if y_max >= 0.0 && y_max < dy {
+                y_max
+            } else {
+                dy
+            };
+            (clamped / y_scale + 1.0e-7).floor() * y_scale
+        } else {
+            0.0
+        };
+        let reused = cell.j == j;
+        if !reused {
+            self.fill_column_cell(col, j, cell);
+        }
+        #[cfg(any(test, feature = "hash-stats"))]
+        hash_stats::record(cell.kind, reused);
+
+        let yv = dy - dy_faded;
+        let yv1 = yv - 1.0;
+        let yc = [yv, yv, yv1, yv1, yv, yv, yv1, yv1];
+        let mut d = [0.0f64; 8];
+        for n in 0..8 {
+            d[n] = (cell.a[n] + cell.g1[n] * yc[n]) + cell.c[n];
+        }
+        let u = smoothstep(dy);
+        let e0 = lerp(col.t, d[0], d[1]);
+        let e1 = lerp(col.t, d[2], d[3]);
+        let e2 = lerp(col.t, d[4], d[5]);
+        let e3 = lerp(col.t, d[6], d[7]);
+        let f0 = lerp(u, e0, e1);
+        let f1 = lerp(u, e2, e3);
+        lerp(col.v, f0, f1)
+    }
+}
+
+/// Whether every lane of a batch has bitwise the same x and the same z, so the column path
+/// ([`ImprovedNoise::column_xz`] / [`ImprovedNoise::sample_y`]) applies.
+#[inline]
+pub(crate) fn uniform_xz(xs: &[f64], zs: &[f64]) -> bool {
+    match (xs.first(), zs.first()) {
+        (Some(x0), Some(z0)) => {
+            xs.iter().all(|x| x.to_bits() == x0.to_bits())
+                && zs.iter().all(|z| z.to_bits() == z0.to_bits())
+        }
+        _ => false,
+    }
+}

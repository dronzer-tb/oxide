+
+    /// `get_values` on a uniform column (every lane the same x and z) takes the column path and
+    /// must equal `get_value` per lane; a batch whose x varies must take the general path and
+    /// equal it too.
+    #[test]
+    fn get_values_column_path_matches_get_value() {
+        for seed in [3i64, 77, 2026] {
+            let mut r = WorldRandom::new(seed, false);
+            let n = PerlinNoise::create(&mut r, -7, vec![1.0, 0.0, 1.0, 0.5, 1.0]);
+            for &(x, z) in &[(12.0, -40.0), (-0.0, 0.0), (1.0e6 + 0.5, -3.0e6)] {
+                let ys: Vec<f64> = (0..49).map(|i| -64.0 + 8.0 * i as f64).collect();
+                let xs = vec![x; 49];
+                let zs = vec![z; 49];
+                let mut out = vec![0.0; 49];
+                n.get_values(&xs, &ys, &zs, &mut out);
+                for i in 0..49 {
+                    assert_eq!(
+                        out[i].to_bits(),
+                        n.get_value(x, ys[i], z).to_bits(),
+                        "uniform {seed} {i}"
+                    );
+                }
+                let mut xs2 = xs.clone();
+                xs2[7] += 1.0;
+                n.get_values(&xs2, &ys, &zs, &mut out);
+                for i in 0..49 {
+                    assert_eq!(
+                        out[i].to_bits(),
+                        n.get_value(xs2[i], ys[i], z).to_bits(),
+                        "mixed {seed} {i}"
+                    );
+                }
+            }
+        }
+    }
 }

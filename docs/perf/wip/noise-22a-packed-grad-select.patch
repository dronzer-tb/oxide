+/// `GRADIENT` packed per axis as sixteen 2-bit two's-complement fields (`+1 = 0b01`,
+/// `0 = 0b00`, `-1 = 0b11`), field `h` at bits `2h..2h+2`. Pinned to the table by a unit test.
+const GRAD_PACKED: [u32; 3] = [0x3100_dddd, 0xdddd_00f5, 0xc4f5_f500];
+
+/// Component `axis` of `GRADIENT[h & 15]`, built with a shift pair and an `i32 -> f64`
+/// conversion rather than a table load, so a loop over lanes needs no gather: exactly
+/// `+1.0`, `-1.0` or `+0.0`, as the table holds them.
+#[inline(always)]
+fn grad_component(h: u64, axis: usize) -> f64 {
+    // Moves field `h` to the top two bits; the arithmetic shift sign-extends it.
+    let shift = 30 - 2 * (h as u32 & 15);
+    f64::from(((GRAD_PACKED[axis] << shift) as i32) >> 30)
+}
+
+/// [`grad_dot`] with the gradient taken from `h`'s low 4 bits by [`grad_component`]: the same

+#[cfg(all(target_arch = "x86_64", target_feature = "avx2"))]
+mod avx2 {
+    use super::{ImprovedNoise, GRADIENT};
+    use std::arch::x86_64::*;
+
+    /// Lanes whose offset coordinate magnitude is not below this (or is NaN) send the whole
+    /// call back to the scalar path. Below it `floor(d)` fits an `i32`, so `_mm256_cvttpd_epi32`
+    /// of the floored value equals Rust's saturating `d.floor() as i32` exactly. Every caller
+    /// wraps coordinates to about ±2^24 first, so this never triggers in generation.
+    const LANE_LIMIT: f64 = 1_073_741_824.0; // 2^30
+
+    #[inline(always)]
+    unsafe fn smoothstep(t: __m256d) -> __m256d {
+        // t * t * t * (t * (t * 6.0 - 15.0) + 10.0), left to right as in the scalar code.
+        let t3 = _mm256_mul_pd(_mm256_mul_pd(t, t), t);
+        let inner = _mm256_sub_pd(_mm256_mul_pd(t, _mm256_set1_pd(6.0)), _mm256_set1_pd(15.0));
+        let poly = _mm256_add_pd(_mm256_mul_pd(t, inner), _mm256_set1_pd(10.0));
+        _mm256_mul_pd(t3, poly)
+    }
+
+    #[inline(always)]
+    unsafe fn lerp(t: __m256d, a: __m256d, b: __m256d) -> __m256d {
+        // a + t * (b - a)
+        _mm256_add_pd(a, _mm256_mul_pd(t, _mm256_sub_pd(b, a)))
+    }
+
+    /// `g[0] * x + g[1] * y + g[2] * z` per lane, with lane `l`'s gradient row
+    /// `GRADIENT[h[l]]`: the same three products and two sums, in the same order.
+    #[inline(always)]
+    unsafe fn grad_dot(h: [u8; 4], x: __m256d, y: __m256d, z: __m256d) -> __m256d {
+        let r0 = &GRADIENT[h[0] as usize];
+        let r1 = &GRADIENT[h[1] as usize];
+        let r2 = &GRADIENT[h[2] as usize];
+        let r3 = &GRADIENT[h[3] as usize];
+        let g0 = _mm256_setr_pd(r0[0], r1[0], r2[0], r3[0]);
+        let g1 = _mm256_setr_pd(r0[1], r1[1], r2[1], r3[1]);
+        let g2 = _mm256_setr_pd(r0[2], r1[2], r2[2], r3[2]);
+        _mm256_add_pd(
+            _mm256_add_pd(_mm256_mul_pd(g0, x), _mm256_mul_pd(g1, y)),
+            _mm256_mul_pd(g2, z),
+        )
+    }
+
+    #[inline(always)]
+    unsafe fn load(v: &[f64; 4]) -> __m256d {
+        _mm256_loadu_pd(v.as_ptr())
+    }
+
+    #[inline(always)]
+    unsafe fn store_i32(v: __m128i) -> [i32; 4] {
+        let mut out = [0i32; 4];
+        _mm_storeu_si128(out.as_mut_ptr() as *mut __m128i, v);
+        out
+    }
+
+    /// See [`ImprovedNoise::noise_with_scale_x4`]. `None` when a lane is out of range.
+    #[inline(always)]
+    pub(super) unsafe fn noise_x4(
+        n: &[&ImprovedNoise; 4],
+        x: &[f64; 4],
+        y: &[f64; 4],
+        z: &[f64; 4],
+        y_scale: &[f64; 4],
+        y_max: &[f64; 4],
+    ) -> Option<[f64; 4]> {
+        let xo = _mm256_setr_pd(n[0].xo, n[1].xo, n[2].xo, n[3].xo);
+        let yo = _mm256_setr_pd(n[0].yo, n[1].yo, n[2].yo, n[3].yo);
+        let zo = _mm256_setr_pd(n[0].zo, n[1].zo, n[2].zo, n[3].zo);
+        let d0 = _mm256_add_pd(load(x), xo);
+        let d1 = _mm256_add_pd(load(y), yo);
+        let d2 = _mm256_add_pd(load(z), zo);
+
+        // Range guard: |d| < 2^30 in every lane (false for NaN, so NaN also falls back).
+        let sign = _mm256_set1_pd(-0.0);
+        let limit = _mm256_set1_pd(LANE_LIMIT);
+        let ok = _mm256_and_pd(
+            _mm256_and_pd(
+                _mm256_cmp_pd::<_CMP_LT_OQ>(_mm256_andnot_pd(sign, d0), limit),
+                _mm256_cmp_pd::<_CMP_LT_OQ>(_mm256_andnot_pd(sign, d1), limit),
+            ),
+            _mm256_cmp_pd::<_CMP_LT_OQ>(_mm256_andnot_pd(sign, d2), limit),
+        );
+        if _mm256_movemask_pd(ok) != 0b1111 {
+            return None;
+        }
+
+        // `i = d.floor() as i32` then `d - i as f64`. Going through the integer (not reusing
+        // the floored double) matters for d == -0.0: floor gives -0.0 but `i as f64` is +0.0.
+        let i = _mm256_cvttpd_epi32(_mm256_floor_pd(d0));
+        let j = _mm256_cvttpd_epi32(_mm256_floor_pd(d1));
+        let k = _mm256_cvttpd_epi32(_mm256_floor_pd(d2));
+        let dx = _mm256_sub_pd(d0, _mm256_cvtepi32_pd(i));
+        let dy = _mm256_sub_pd(d1, _mm256_cvtepi32_pd(j));
+        let dz = _mm256_sub_pd(d2, _mm256_cvtepi32_pd(k));
+
+        // Y smear, both branches computed and selected per lane:
+        //   clamped  = if y_max >= 0.0 && y_max < dy { y_max } else { dy }
+        //   dy_faded = if y_scale != 0.0 { (clamped / y_scale + 1.0e-7).floor() * y_scale } else { 0.0 }

+/// Placeholder for unused lanes of a [`SampleQueue`]; never sampled for a result that is used.
+static PAD_NOISE: ImprovedNoise = ImprovedNoise {
+    permutation: [0; 512],
+    xo: 0.0,
+    yo: 0.0,
+    zo: 0.0,
+};
+
+/// Batches independent octave samples four at a time through
+/// [`ImprovedNoise::noise_with_scale_x4`]. Every sample carries a caller-chosen `tag` and two
+/// weights; `sink(tag, wa, wb, sample)` is called once per sample, in exactly the order the
+/// samples were pushed, so a caller that accumulates in `sink` sums in its original order.
+pub(crate) struct SampleQueue<'a> {
+    noises: [&'a ImprovedNoise; 4],
+    x: [f64; 4],
+    y: [f64; 4],
+    z: [f64; 4],
+    y_scale: [f64; 4],
+    y_max: [f64; 4],
+    tag: [u8; 4],
+    wa: [f64; 4],
+    wb: [f64; 4],
+    len: usize,
+}
+
+impl<'a> SampleQueue<'a> {
+    #[inline(always)]
+    pub(crate) fn new() -> Self {
+        Self {
+            noises: [&PAD_NOISE; 4],
+            x: [0.0; 4],
+            y: [0.0; 4],
+            z: [0.0; 4],
+            y_scale: [0.0; 4],
+            y_max: [0.0; 4],
+            tag: [0; 4],
+            wa: [0.0; 4],
+            wb: [0.0; 4],
+            len: 0,
+        }
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    #[inline(always)]
+    pub(crate) fn push(
+        &mut self,
+        noise: &'a ImprovedNoise,
+        coords: [f64; 5],
+        tag: u8,
+        wa: f64,
+        wb: f64,
+        sink: &mut impl FnMut(u8, f64, f64, f64),
+    ) {
+        let l = self.len;
+        self.noises[l] = noise;
+        self.x[l] = coords[0];
+        self.y[l] = coords[1];
+        self.z[l] = coords[2];
+        self.y_scale[l] = coords[3];
+        self.y_max[l] = coords[4];
+        self.tag[l] = tag;
+        self.wa[l] = wa;
+        self.wb[l] = wb;
+        self.len = l + 1;
+        if self.len == 4 {
+            self.flush(4, sink);
+        }
+    }
+
+    #[inline(always)]
+    fn flush(&mut self, n: usize, sink: &mut impl FnMut(u8, f64, f64, f64)) {
+        let out = ImprovedNoise::noise_with_scale_x4(
+            self.noises,
+            self.x,
+            self.y,
+            self.z,
+            self.y_scale,
+            self.y_max,
+        );
+        for l in 0..n {
+            sink(self.tag[l], self.wa[l], self.wb[l], out[l]);
+        }
+        self.len = 0;
+    }
+
+    /// Emits the 0-3 samples still queued: one sample goes through the scalar path, two or
+    /// three are padded (with copies of lane 0, whose extra results are discarded).
+    #[inline(always)]
+    pub(crate) fn finish(&mut self, sink: &mut impl FnMut(u8, f64, f64, f64)) {
+        match self.len {
+            0 => {}
+            1 => {
+                let s = self.noises[0].noise_with_scale(
+                    self.x[0],
+                    self.y[0],
+                    self.z[0],
+                    self.y_scale[0],
+                    self.y_max[0],
+                );
+                sink(self.tag[0], self.wa[0], self.wb[0], s);
+                self.len = 0;
+            }
+            n => {
+                for l in n..4 {
+                    self.noises[l] = self.noises[0];
+                    self.x[l] = self.x[0];
+                    self.y[l] = self.y[0];
+                    self.z[l] = self.z[0];
+                    self.y_scale[l] = self.y_scale[0];
+                    self.y_max[l] = self.y_max[0];
+                }
+                self.flush(n, sink);
+            }
+        }
+    }
+}

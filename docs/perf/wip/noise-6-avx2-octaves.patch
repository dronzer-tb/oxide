+    /// Four independent `noise_with_scale` samples, lane `l` being
+    /// `noises[l].noise_with_scale(x[l], y[l], z[l], y_scale[l], y_max[l])` bit for bit. The
+    /// lanes may use different instances. With AVX2 the float work runs four-wide (each lane
+    /// doing exactly the scalar IEEE operations in the scalar order, no FMA); otherwise, or
+    /// when any lane's offset coordinate is out of the guarded range, it is four scalar calls.
+    #[inline]
+    pub fn noise_with_scale_x4(
+        noises: [&ImprovedNoise; 4],
+        x: [f64; 4],
+        y: [f64; 4],
+        z: [f64; 4],
+        y_scale: [f64; 4],
+        y_max: [f64; 4],
+    ) -> [f64; 4] {
+        #[cfg(all(target_arch = "x86_64", target_feature = "avx2"))]
+        {
+            // SAFETY: AVX2 is enabled for the whole build (`cfg` above).
+            if let Some(out) = unsafe { avx2::noise_x4(&noises, &x, &y, &z, &y_scale, &y_max) } {
+                return out;
+            }
+        }
+        Self::noise_with_scale_x4_scalar(noises, x, y, z, y_scale, y_max)
+    }
+
+    #[inline(never)]

+    #[test]
+    fn batched_compute_matches_reference_bit_for_bit() {
+        use oxide_core::{LegacyRandom, RandomSource};
+        let param_sets = [
+            overworld(),
+            // `BASE_3D_NOISE_NETHER`.
+            BlendedNoiseParams {
+                xz_scale: 0.25,
+                y_scale: 0.375,
+                xz_factor: 80.0,
+                y_factor: 60.0,
+                smear_scale_multiplier: 8.0,
+            },
+            // `BASE_3D_NOISE_END`.
+            BlendedNoiseParams {
+                xz_scale: 0.25,
+                y_scale: 0.25,
+                xz_factor: 80.0,
+                y_factor: 160.0,
+                smear_scale_multiplier: 4.0,
+            },
+            // A steep selector, so both saturated branches (one limit stack skipped) are hit.
+            BlendedNoiseParams {
+                xz_scale: 1.0,
+                y_scale: 1.0,
+                xz_factor: 0.5,
+                y_factor: 0.5,
+                smear_scale_multiplier: 0.0,
+            },
+        ];
+        let mut rng = LegacyRandom::new(0xb1e0d);
+        let (mut saw_min, mut saw_max, mut saw_mid) = (0u32, 0u32, 0u32);
+        for seed in 0..6i64 {
+            let mut r = WorldRandom::new(seed * 31 + 9, seed % 2 == 1);
+            let n = BlendedNoise::new(&mut r);
+            for params in &param_sets {
+                for k in 0..1500 {
+                    let s = [16.0, 1.0e3, 3.0e7][k % 3];
+                    let x = (rng.next_double() * 2.0 - 1.0) * s;
+                    let y = if k % 13 == 0 {
+                        -0.0
+                    } else {
+                        (rng.next_double() * 2.0 - 1.0) * 400.0
+                    };
+                    let z = if k % 7 == 0 {
+                        x.floor()
+                    } else {
+                        (rng.next_double() * 2.0 - 1.0) * s
+                    };
+                    let fast = n.compute(params, x, y, z);
+                    let slow = compute_reference(&n, params, x, y, z);
+                    assert_eq!(
+                        fast.to_bits(),
+                        slow.to_bits(),
+                        "seed {seed} params {params:?} at ({x}, {y}, {z})"
+                    );
+                }
+            }
+            // Selector coverage on the steep parameter set.
+            let steep = &param_sets[3];
+            for k in 0..400 {
+                let x = k as f64 * 0.37 - 70.0;
+                let main = selector(&n, steep, x, 3.0, -x);
+                if main >= 1.0 {
+                    saw_max += 1;
+                } else if main <= 0.0 {
+                    saw_min += 1;
+                } else {
+                    saw_mid += 1;
+                }
+                assert_eq!(
+                    n.compute(steep, x, 3.0, -x).to_bits(),
+                    compute_reference(&n, steep, x, 3.0, -x).to_bits()
+                );
+            }
+        }
+        assert!(
+            saw_min > 0 && saw_max > 0 && saw_mid > 0,
+            "{saw_min} {saw_max} {saw_mid}"
+        );
+    }

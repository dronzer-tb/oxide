+        noises: [&ImprovedNoise; 4],
+        x: [f64; 4],
+        y: [f64; 4],
+        z: [f64; 4],
+        y_scale: [f64; 4],
+        y_max: [f64; 4],
+    ) -> [f64; 4] {

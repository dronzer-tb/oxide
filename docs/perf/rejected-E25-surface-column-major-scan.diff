+/// The shape of one below-surface band's program, as far as the column scan cares.
+#[derive(Clone, Copy)]
+enum BandShape {
+    /// No ops: evaluation places nothing and has no side effect, so the position needs no
+    /// cursor and no evaluation.
+    Empty,
+    /// The first op is a `block`: evaluation returns it without testing, reading or drawing
+    /// anything.
+    Const(usize),
+    /// Evaluated as usual; `reads_biome` says whether a test reads the position's biome.
+    Eval { reads_biome: bool },
+}
+
+impl BandShape {
+    fn of(ops: &[Op<'_>]) -> Self {
+        match ops.first() {
+            None => BandShape::Empty,
+            Some(Op::Block(result)) => BandShape::Const(*result),
+            Some(_) => BandShape::Eval {
+                reads_biome: reads_biome(ops),
+            },
+        }
+    }
+}
+
+/// Whether evaluating `ops` can read [`Cursor::biome`]: only the `biome` and `temperature`
+/// conditions do, and [`flatten`] leaves no `not` around a test's condition.
+fn reads_biome(ops: &[Op<'_>]) -> bool {
+    ops.iter().any(|op| {
+        matches!(
+            op,
+            Op::Test {
+                condition: CompiledCondition::Biome(_) | CompiledCondition::Temperature,
+                ..
+            }
+        )
+    })
+}
+
+/// [`BlockKind`]s as the bytes of the per-chunk, column-major kind array the scan walks. Air
+/// is 0 so an all-air stretch reads as zero words, and air and fluid -- the two kinds that end
+/// a run -- are the two lowest.
+const KIND_AIR: u8 = BlockKind::Air as u8;
+const KIND_FLUID: u8 = BlockKind::DefaultFluid as u8;
+const KIND_BLOCK: u8 = BlockKind::DefaultBlock as u8;
+
+/// Index of the highest non-air entry of `column`, eight entries at a time over the air.
+fn top_non_air(column: &[u8]) -> Option<usize> {
+    let mut end = column.len();
+    while end >= 8 {
+        let word = u64::from_ne_bytes(column[end - 8..end].try_into().unwrap());
+        if word != 0 {
+            break;
+        }
+        end -= 8;
+    }
+    column[..end].iter().rposition(|&kind| kind != KIND_AIR)
+}
+
+/// Index of the lowest entry of the run of non-air, non-fluid entries of `column` that holds
+/// index `i`.
+fn run_bottom_index(column: &[u8], i: usize) -> usize {
+    match column[..i].iter().rposition(|&kind| kind <= KIND_FLUID) {
+        Some(end) => end + 1,
+        None => 0,
+    }
+}

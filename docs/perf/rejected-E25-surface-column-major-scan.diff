+    /// Writes rule result `result` at `slot` of section `section_index`, interning it into
+    /// that section's palette the first time the section receives it (`result_index[cached]`).
+    #[inline]
+    fn write_result(
+        &self,
+        chunk: &mut ChunkData,
+        result_index: &mut [u32],
+        cached: usize,
+        result: usize,
+        section_index: usize,
+        slot: usize,
+    ) {
+        let cached = &mut result_index[cached];
+        let block_states = &mut chunk.sections[section_index].block_states;
+        if *cached == u32::MAX {
+            // Interning can add a palette entry this section did not have. No classification
+            // needs it: kinds were read up front, and a written position is never read again.
+            *cached = block_states.index_of_or_insert(self.result_state(result).clone());
+        }
+        block_states.set_index(slot, *cached);
+    }

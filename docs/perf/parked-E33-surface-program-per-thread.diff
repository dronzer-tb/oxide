+        (VerticalAnchor::Absolute { absolute: a }, VerticalAnchor::Absolute { absolute: b }) => {
+            a == b
+        }
+        (
+            VerticalAnchor::AboveBottom { above_bottom: a },
+            VerticalAnchor::AboveBottom { above_bottom: b },
+        ) => a == b,
+        (VerticalAnchor::BelowTop { below_top: a }, VerticalAnchor::BelowTop { below_top: b }) => {
+            a == b
+        }
+        (
+            VerticalAnchor::Absolute { .. }
+            | VerticalAnchor::AboveBottom { .. }
+            | VerticalAnchor::BelowTop { .. },
+            _,
+        ) => false,
+    }
+}

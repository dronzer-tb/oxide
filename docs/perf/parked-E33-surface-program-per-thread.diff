+/// Whether two rule trees are the same tree, field for field: the key that matches a cached
+/// [`SurfaceProgram`] to the settings it was built from. Strict where the datapack types allow
+/// it -- thresholds compare by bits -- so a false "different" only costs a rebuild. The match
+/// is exhaustive with no wildcard arm on either side's variants, so a field added to a rule or
+/// condition fails to compile here until it is compared.
+fn rule_eq(a: &SurfaceRule, b: &SurfaceRule) -> bool {
+    match (a, b) {
+        (SurfaceRule::Sequence { sequence: a }, SurfaceRule::Sequence { sequence: b }) => {
+            a.len() == b.len() && a.iter().zip(b).all(|(a, b)| rule_eq(a, b))
+        }
+        (
+            SurfaceRule::Condition {
+                if_true: a_if,
+                then_run: a_then,
+            },
+            SurfaceRule::Condition {
+                if_true: b_if,
+                then_run: b_then,
+            },
+        ) => condition_eq(a_if, b_if) && rule_eq(a_then, b_then),
+        (SurfaceRule::Block { result_state: a }, SurfaceRule::Block { result_state: b }) => a == b,
+        (SurfaceRule::Badlands {}, SurfaceRule::Badlands {}) => true,
+        (
+            SurfaceRule::Sequence { .. }
+            | SurfaceRule::Condition { .. }
+            | SurfaceRule::Block { .. }
+            | SurfaceRule::Badlands {},
+            _,
+        ) => false,
+    }
+}

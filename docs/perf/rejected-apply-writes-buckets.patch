From 7968121e2362c7c38cb2a190b983d24a83df2c51 Mon Sep 17 00:00:00 2001
From: Kasniya <36neelansh@gmail.com>
Date: Mon, 16 Nov 2026 14:24:45 +0000
Subject: [PATCH] perf(pregen): group each region's writes by target chunk once

A finished chunk takes writes from its nine neighbour regions, so every
region's writes were walked nine times, eight of them only to skip writes
landing elsewhere. Each region's writes are now grouped by the chunk of its
3x3 they land in with a stable counting sort, and a finished chunk reads only
its own group. Each chunk sees its writes in the same order as before, so
palette order and section bytes are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/oxide-pregen/src/generate.rs | 108 +++++++++++++++++++++++-----
 1 file changed, 91 insertions(+), 17 deletions(-)

diff --git a/crates/oxide-pregen/src/generate.rs b/crates/oxide-pregen/src/generate.rs
index d5a3289..ff25095 100644
--- a/crates/oxide-pregen/src/generate.rs
+++ b/crates/oxide-pregen/src/generate.rs
@@ -31,7 +31,7 @@ use oxide_chunkgen::{
     Decorator,
 };
 use oxide_chunkgen::region::InternedWrites;
-use oxide_core::{ChunkData, ChunkPos, ChunkStatus, ResourceLocation};
+use oxide_core::{BlockPos, BlockState, ChunkData, ChunkPos, ChunkStatus, ResourceLocation};
 use oxide_datapack::{
     load_datapack, BiomeSource, BlockFacts, ConfiguredCarver, MultiNoiseSource,
     NoiseGeneratorSettings,
@@ -178,28 +178,97 @@ fn square(center: ChunkPos, radius: i32) -> Vec<ChunkPos> {
         .collect()
 }
 
-/// Applies `writes` (all from one source chunk) that land inside `chunk`.
+/// One chunk's decoration writes, grouped by the chunk of the 3x3 around it they land in.
 ///
-/// Each interned state's palette index is worked out once per section, the first time a write
-/// of it lands there, exactly as before: the first palette entry equal to it, or a new entry
-/// (cloned and hashed only then, which is when `PalettedContainer::set` would insert it, so
-/// palette order is unchanged). A palette only grows, so the index found stays the first equal
-/// entry for every later write of that state to that section.
-fn apply_writes(chunk: &mut ChunkData, writes: &InternedWrites) {
+/// A finished chunk takes writes from its nine neighbours, so each region's writes were walked
+/// nine times, eight of them to skip writes landing elsewhere. Grouping them once (a stable
+/// counting sort, so each group keeps the writes' order) lets a chunk read only its own group,
+/// in the same order as before.
+struct ChunkWrites {
+    /// The writes, group by group, each group in the original order.
+    writes: Vec<(BlockPos, u32)>,
+    /// Group `k` (chunk `(k % 3 - 1, k / 3 - 1)` from the source) is `starts[k]..starts[k + 1]`;
+    /// group 9 holds writes outside the 3x3, which no chunk takes.
+    starts: [usize; 11],
+    states: Vec<BlockState>,
+}
+
+thread_local! {
+    /// [`ChunkWrites::new`]'s sorting space, kept per thread.
+    static SCRATCH: std::cell::RefCell<Vec<(BlockPos, u32)>> =
+        const { std::cell::RefCell::new(Vec::new()) };
+}
+
+impl ChunkWrites {
+    fn new(source: ChunkPos, interned: InternedWrites) -> Self {
+        let group = |at: BlockPos| {
+            let (dx, dz) = ((at.x >> 4) - source.x + 1, (at.z >> 4) - source.z + 1);
+            if (0..3).contains(&dx) && (0..3).contains(&dz) {
+                (dz * 3 + dx) as usize
+            } else {
+                9
+            }
+        };
+        let mut counts = [0usize; 10];
+        for &(at, _) in &interned.writes {
+            counts[group(at)] += 1;
+        }
+        let mut starts = [0usize; 11];
+        for k in 0..10 {
+            starts[k + 1] = starts[k] + counts[k];
+        }
+        // Sorted through a per-thread scratch list and copied back in place: a fresh list per
+        // region (and freeing the old one) cost more in page faults than the walk saved.
+        let mut writes = interned.writes;
+        SCRATCH.with(|scratch| {
+            let mut sorted = scratch.borrow_mut();
+            sorted.clear();
+            sorted.resize(writes.len(), (BlockPos::new(0, 0, 0), 0));
+            let mut next = starts;
+            for &(at, id) in &writes {
+                let k = group(at);
+                sorted[next[k]] = (at, id);
+                next[k] += 1;
+            }
+            writes.copy_from_slice(&sorted);
+        });
+        Self {
+            writes,
+            starts,
+            states: interned.states,
+        }
+    }
+
+    /// The writes landing in the chunk `(dx, dz)` from the source, in their original order.
+    fn landing_in(&self, dx: i32, dz: i32) -> &[(BlockPos, u32)] {
+        let k = ((dz + 1) * 3 + (dx + 1)) as usize;
+        &self.writes[self.starts[k]..self.starts[k + 1]]
+    }
+}
+
+/// Applies `writes`, which all land in `chunk`'s columns, naming states in `states`.
+///
+/// Each state's palette index is worked out once per section, the first time a write of it
+/// lands there, exactly as before: the first palette entry equal to it, or a new entry (cloned
+/// and hashed only then, which is when `PalettedContainer::set` would insert it, so palette
+/// order is unchanged). A palette only grows, so the index found stays the first equal entry
+/// for every later write of that state to that section.
+fn apply_writes(chunk: &mut ChunkData, writes: &[(BlockPos, u32)], states: &[BlockState]) {
     const UNKNOWN: u32 = u32::MAX;
     let (min_y, height) = (chunk.min_y, chunk.height);
-    let states = writes.states.len();
-    let mut known = vec![UNKNOWN; chunk.sections.len() * states];
-    for &(at, id) in &writes.writes {
-        if at.chunk_pos() != chunk.pos || at.y < min_y || at.y >= min_y + height {
+    let count = states.len();
+    let mut known = vec![UNKNOWN; chunk.sections.len() * count];
+    for &(at, id) in writes {
+        debug_assert_eq!(at.chunk_pos(), chunk.pos);
+        if at.y < min_y || at.y >= min_y + height {
             continue;
         }
         let y = (at.y - min_y) as usize;
         let slot = ((y & 15) * 16 + (at.z & 15) as usize) * 16 + (at.x & 15) as usize;
         let section = &mut chunk.sections[y >> 4].block_states;
-        let cached = &mut known[(y >> 4) * states + id as usize];
+        let cached = &mut known[(y >> 4) * count + id as usize];
         if *cached == UNKNOWN {
-            let state = &writes.states[id as usize];
+            let state = &states[id as usize];
             *cached = match section.palette().iter().position(|p| p == state) {
                 Some(i) => i as u32,
                 None => section.index_of_or_insert(state.clone()),
@@ -275,7 +344,7 @@ pub fn run(generator: &Generator, opts: &Options<'_>) -> Result<Outcome> {
     // in `oxide_chunkgen::decorate::decorated_chunk`'s order.
     let started = Instant::now();
     let (min_y, height) = (terrain[0].min_y, terrain[0].height);
-    let writes: Vec<InternedWrites> = square(opts.center, writes_radius)
+    let writes: Vec<ChunkWrites> = square(opts.center, writes_radius)
         .par_iter()
         .map(|&c| {
             let refs: [&ChunkData; 9] = std::array::from_fn(|i| {
@@ -284,7 +353,7 @@ pub fn run(generator: &Generator, opts: &Options<'_>) -> Result<Outcome> {
                     c.z + (i / 3) as i32 - 1,
                 ))
             });
-            generator.decoration_writes(refs)
+            ChunkWrites::new(c, generator.decoration_writes(refs))
         })
         .collect();
     let inner = square(opts.center, opts.radius);
@@ -306,7 +375,12 @@ pub fn run(generator: &Generator, opts: &Options<'_>) -> Result<Outcome> {
                 for dz in -1..=1 {
                     let source = ChunkPos::new(pos.x + dx, pos.z + dz);
                     let i = index(source, writes_radius).expect("inside the writes square");
-                    apply_writes(&mut chunk, &writes[i]);
+                    let source_writes = &writes[i];
+                    apply_writes(
+                        &mut chunk,
+                        source_writes.landing_in(-dx, -dz),
+                        &source_writes.states,
+                    );
                 }
             }
             chunk.heightmaps = heightmaps(&chunk, facts);

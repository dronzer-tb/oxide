+/// Splits the world's height into bands within which every condition [`Facts::known`] can
+/// settle from y alone has one answer. Returns the band of each y (from `min_y`) and each
+/// band's inclusive y range.
+fn y_bands(program: &[Op<'_>], min_y: i32, height: i32) -> (Vec<u16>, Vec<(i32, i32)>) {
+    let top = min_y + height; // exclusive
+    // Every y at which a new band starts.
+    let mut edges = vec![min_y];
+    for op in program {
+        if let Op::Test { condition, .. } = op {
+            match condition {
+                CompiledCondition::VerticalGradient { true_y, false_y, .. } => {
+                    edges.push(true_y.saturating_add(1));
+                    edges.push(*false_y);
+                }
+                CompiledCondition::YAbove {
+                    anchor_y,
+                    surface_depth_multiplier: 0,
+                    add_stone_depth: false,
+                } => edges.push(*anchor_y),
+                _ => {}
+            }
+        }
+    }
+    edges.retain(|&y| y >= min_y && y < top);
+    edges.sort_unstable();
+    edges.dedup();
+    let bands: Vec<(i32, i32)> = edges
+        .iter()
+        .enumerate()
+        .map(|(i, &lo)| (lo, edges.get(i + 1).map_or(top - 1, |&next| next - 1)))
+        .collect();
+    let mut band_of_y = Vec::with_capacity(height.max(0) as usize);
+    for (index, &(lo, hi)) in bands.iter().enumerate() {
+        for _ in lo..=hi {
+            band_of_y.push(index as u16);
+        }
+    }
+    (band_of_y, bands)
+}

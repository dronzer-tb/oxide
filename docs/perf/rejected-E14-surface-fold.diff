+/// What is known about every position a specialised program (see [`fold`]) will be offered.
+/// Each fact is a plain function of the position, so a condition it settles has the same value
+/// at every one of those positions.
+#[derive(Clone, Copy)]
+struct Facts {
+    /// The positions' y lies in `y_lo..=y_hi`.
+    y_lo: i32,
+    y_hi: i32,
+    /// `y >= min_surface_level`: the answer `above_preliminary_surface` gives.
+    above_preliminary_surface: bool,
+    /// `stone_depth_above >= 2`; otherwise it is exactly 1 (a position is offered only after
+    /// the scan has counted it).
+    below_top: bool,
+    /// No fluid above in this run (`water_height == i32::MIN`): every `water` condition holds.
+    dry: bool,
+}
+
+impl Facts {
+    /// The value `condition` has at every position these facts describe, when they settle it.
+    /// `None` keeps the test in the specialised program, where it is evaluated as usual.
+    fn known(&self, condition: &CompiledCondition<'_>) -> Option<bool> {
+        match condition {
+            // Same order of checks as the evaluator: `true_y` first.
+            CompiledCondition::VerticalGradient { true_y, false_y, .. } => {
+                if self.y_hi <= *true_y {
+                    Some(true)
+                } else if self.y_lo > *true_y && self.y_lo >= *false_y {
+                    Some(false)
+                } else {
+                    None
+                }
+            }
+            // `y + 0 >= anchor_y + surface_depth * 0`: y alone decides it.
+            CompiledCondition::YAbove {
+                anchor_y,
+                surface_depth_multiplier: 0,
+                add_stone_depth: false,
+            } => {
+                if self.y_lo >= *anchor_y {
+                    Some(true)
+                } else if self.y_hi < *anchor_y {
+                    Some(false)
+                } else {
+                    None
+                }
+            }
+            CompiledCondition::AbovePreliminarySurface => Some(self.above_preliminary_surface),
+            // The evaluator answers `true` before reading anything else when there is no fluid.
+            CompiledCondition::Water { .. } if self.dry => Some(true),
+            // `stone_depth_above <= 1 + offset` with nothing column-dependent added: decided by
+            // whether the depth is 1 or at least 2. Offsets far from 0 are left alone rather
+            // than reasoned about near overflow.
+            CompiledCondition::StoneDepth {
+                offset,
+                add_surface_depth: false,
+                secondary_depth_range: 0,
+                ceiling: false,
+            } if offset.abs() < 1 << 20 => {
+                if self.below_top {
+                    // depth >= 2: false when 1 + offset < 2; otherwise depends on the depth.
+                    if *offset < 1 { Some(false) } else { None }
+                } else {
+                    // depth == 1.
+                    Some(1 <= 1 + offset)
+                }
+            }
+            _ => None,
+        }
+    }
+}
+
+/// Appends to `out` the part of `ops[start..end]` (one `sequence` level: a run of sibling
+/// items) that can still be reached at positions described by `facts`. A test those facts
+/// settle is dropped: a test that holds becomes its `then_run` laid inline, as a `sequence`
+/// member (which is what a passing condition's `then_run` is: when it places nothing,
+/// evaluation falls through to the next sibling), and one that fails drops its `then_run`.
+/// Every condition is a pure function of the position and its column -- the memos cache
+/// column-only values, and each random draw is seeded from (x, y, z) alone -- so leaving
+/// out a test whose answer is known changes no other test's answer, and the first `block`
+/// reached is the same one.
+///
+/// Returns whether this level always places a block, which makes every later sibling dead.
+fn fold<'a>(
+    ops: &[Op<'a>],
+    start: usize,
+    end: usize,
+    facts: &Facts,
+    out: &mut Vec<Op<'a>>,
+) -> bool {
+    let mut i = start;
+    while i < end {
+        match &ops[i] {
+            Op::Block(result) => {
+                out.push(Op::Block(*result));
+                return true;
+            }
+            Op::Badlands => {
+                out.push(Op::Badlands);
+                return true;
+            }
+            Op::Test {
+                condition,
+                negate,
+                skip,
+            } => {
+                match facts.known(condition).map(|value| value != *negate) {
+                    Some(true) => {
+                        if fold(ops, i + 1, *skip, facts, out) {
+                            return true;
+                        }
+                    }
+                    Some(false) => {}
+                    None => {
+                        let at = out.len();
+                        out.push(Op::Test {
+                            condition: condition.clone(),
+                            negate: *negate,
+                            skip: 0,
+                        });
+                        fold(ops, i + 1, *skip, facts, out);
+                        let after = out.len();
+                        if let Op::Test { skip, .. } = &mut out[at] {
+                            *skip = after;
+                        }
+                    }
+                }
+                i = *skip;
+            }
+        }
+    }
+    false
+}

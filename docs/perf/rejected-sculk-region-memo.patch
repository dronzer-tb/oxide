 }
 
+/// What one sculk feature remembers from run to run within one region: per [`StateKey`] slot
+/// the last state it described, and the region ids of the states it writes. A region sees about
+/// three runs that get past `can_spread_from`, and each run used to describe and intern its
+/// states afresh. Keys and ids name states only within one region, so the memo is tagged with
+/// the region's serial and starts over in a new region. Interning order is unchanged: a run
+/// that finds an id here would have interned a state the region already holds.
+struct Memo {
+    /// The feature's address: features live for the whole of decoration.
+    feature: usize,
+    /// [`DecorationRegion::serial`] of the region `infos` and `ids` belong to.
+    ///
+    /// [`DecorationRegion::serial`]: crate::region::DecorationRegion::serial
+    serial: u64,
+    /// Per `StateKey::slot`, the last state described there.
+    infos: Box<[Cell<Option<(StateKey, Info)>>]>,
+    ids: Ids,
+}
+
+thread_local! {
+    /// The memos of the sculk features this thread has placed, at most one per feature.
+    static MEMOS: RefCell<Vec<Memo>> = const { RefCell::new(Vec::new()) };
+}
+
+impl Memo {
+    /// `feature`'s memo for the region with serial `serial`.
+    fn take(feature: &SculkPatchFeature, serial: u64) -> Self {
+        let feature = feature as *const SculkPatchFeature as usize;
+        let found = MEMOS.with(|memos| {
+            let mut memos = memos.borrow_mut();
+            let index = memos.iter().position(|memo| memo.feature == feature)?;
+            Some(memos.swap_remove(index))
+        });
+        let mut memo = found.unwrap_or_else(|| Memo {
+            feature,
+            serial,
+            infos: (0..INFO_SLOTS).map(|_| Cell::new(None)).collect(),
+            ids: Ids::default(),
+        });
+        if memo.serial != serial {
+            memo.serial = serial;
+            for slot in memo.infos.iter() {
+                slot.set(None);
+            }
+            memo.ids = Ids::default();
+        }
+        memo
+    }
+
+    fn give_back(self) {
+        MEMOS.with(|memos| memos.borrow_mut().push(self));
+    }
+}
+
 impl Deref for Spreader<'_, '_> {
     type Target = SculkPatchFeature;
 

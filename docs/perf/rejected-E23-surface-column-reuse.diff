+    /// [`Self::eval_program`] over the above-surface program, which also works out how far
+    /// down the current run of ground its answer provably holds.
+    ///
+    /// The program's answer is decided by the answers of the tests on the path it took. Each
+    /// of them is checked by [`Self::eval_condition_span`] for how many positions further down
+    /// the same run (one lower y, one more `stone_depth_above`, one less `stone_depth_below`,
+    /// the same water height and column) its answer stays the same; the minimum over the path
+    /// is how far the whole answer holds. Biome-dependent tests hold only while the biome does.
+    fn eval_above(&self, cursor: &Cursor, column: &Column, biomes: &ChunkBiomes) -> Reuse {
+        let program = &self.program[..];
+        let mut span = i32::MAX;
+        let mut biome_dependent = false;
+        let mut pc = 0;
+        let outcome = loop {
+            let Some(op) = program.get(pc) else {
+                break Outcome::Keep;
+            };
+            match op {
+                Op::Test {
+                    condition,
+                    negate,
+                    skip,
+                } => {
+                    let (value, holds) = self.eval_condition_span(
+                        condition,
+                        cursor,
+                        column,
+                        biomes,
+                        &mut biome_dependent,
+                    );
+                    span = span.min(holds);
+                    if value != *negate {
+                        pc += 1;
+                    } else {
+                        pc = *skip;
+                    }
+                }
+                Op::Block(result) => break Outcome::Place(*result),
+                // The band depends on y: the caller computes it at every position, this one
+                // included, as `eval_program` would have here.
+                Op::Badlands => break Outcome::Badlands,
+            }
+        };
+        Reuse {
+            outcome,
+            lowest_y: cursor.y.saturating_sub(span),
+            biome: biome_dependent.then_some(cursor.biome),
+        }
+    }
+
+    /// `eval_condition`'s answer, evaluated exactly as it would be (same memos, same draws),
+    /// plus the number of positions further down the same run at which the answer is certain
+    /// to be the same and evaluating it would make no draw: `i32::MAX` for "all of them".
+    /// Sets `biome_dependent` when the answer also depends on the position's biome.
+    fn eval_condition_span(
+        &self,
+        condition: &CompiledCondition<'a>,
+        cursor: &Cursor,
+        column: &Column,
+        biomes: &ChunkBiomes,
+        biome_dependent: &mut bool,
+    ) -> (bool, i32) {
+        let value = self.eval_condition(condition, cursor, column, biomes);
+        let holds = match condition {
+            CompiledCondition::Biome(_) => {
+                *biome_dependent = true;
+                i32::MAX
+            }
+            // Column-only.
+            CompiledCondition::Noise2d { .. }
+            | CompiledCondition::Steep { .. }
+            | CompiledCondition::Hole => i32::MAX,
+            CompiledCondition::Noise3d { .. } => 0,
+            // Below `true_y` it is true at every lower y; at or above `false_y` it stays false
+            // down to `false_y`. Neither draws. Inside the band it drew: never reused.
+            CompiledCondition::VerticalGradient {
+                true_y, false_y, ..
+            } => {
+                if cursor.y <= *true_y {
+                    i32::MAX
+                } else if cursor.y >= *false_y {
+                    cursor.y - false_y
+                } else {
+                    0
+                }
+            }
+            // `y + stone_depth_above` does not change down a run. Without the stone depth,
+            // `y >= threshold` stays true down to the threshold and false below it.
+            CompiledCondition::YAbove {
+                anchor_y,
+                surface_depth_multiplier,
+                add_stone_depth,
+            } => {
+                if *add_stone_depth || !value {
+                    i32::MAX
+                } else {
+                    cursor.y - (anchor_y + column.surface_depth * surface_depth_multiplier)
+                }
+            }
+            // The water height is the run's: it only changes where the run ends.
+            CompiledCondition::Water {
+                offset,
+                surface_depth_multiplier,
+                add_stone_depth,
+            } => {
+                if cursor.water_height == i32::MIN || *add_stone_depth || !value {
+                    i32::MAX
+                } else {
+                    cursor.y
+                        - (cursor.water_height
+                            + offset
+                            + column.surface_depth * surface_depth_multiplier)
+                }
+            }
+            // The biome's base temperature at and below y 80, otherwise a function of y too.
+            CompiledCondition::Temperature => {
+                *biome_dependent = true;
+                if cursor.y > 80 {
+                    0
+                } else {
+                    i32::MAX
+                }
+            }
+            CompiledCondition::AbovePreliminarySurface => {
+                if value {
+                    cursor.y - column.min_surface_level
+                } else {
+                    i32::MAX
+                }
+            }
+            // Floor depth grows by one per step down: true holds while it stays within the
+            // bound, false holds for good. Ceiling depth shrinks by one: the reverse.
+            CompiledCondition::StoneDepth {
+                offset,
+                add_surface_depth,
+                secondary_depth_range,
+                ceiling,
+            } => {
+                let surface = if *add_surface_depth {
+                    column.surface_depth
+                } else {
+                    0
+                };
+                let secondary = if *secondary_depth_range == 0 {
+                    0
+                } else {
+                    // Already sampled by the evaluation above: a memo read.
+                    map_range(
+                        self.surface_secondary(column),
+                        -1.0,
+                        1.0,
+                        0.0,
+                        *secondary_depth_range as f64,
+                    ) as i32
+                };
+                let bound = 1 + offset + surface + secondary;
+                match (*ceiling, value) {
+                    (false, true) => bound - cursor.stone_depth_above,
+                    (false, false) => i32::MAX,
+                    (true, true) => i32::MAX,
+                    (true, false) => cursor.stone_depth_below - bound - 1,
+                }
+            }
+            // Not reached for leading `not`s (folded into the test's negate flag); a nested
+            // one is evaluated exactly, and not reused.
+            CompiledCondition::Not(_) => 0,
+        };
+        (value, holds)
+    }

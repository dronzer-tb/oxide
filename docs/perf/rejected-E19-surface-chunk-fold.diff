+    /// Writes rule result `result` at `slot` of section `section_index`, interning it into that
+    /// section's palette on the section's first write of it.
+    fn write(
+        &self,
+        chunk: &mut ChunkData,
+        result_index: &mut [u32],
+        section_index: usize,
+        slot: usize,
+        result: usize,
+    ) {
+        let result_count = self.results.len() + BAND_COUNT;
+        let cached = &mut result_index[section_index * result_count + result];
+        let block_states = &mut chunk.sections[section_index].block_states;
+        if *cached == u32::MAX {
+            // Interning can add a palette entry this section did not have. No classification
+            // needs it: kinds were read up front, and a written position is never read again.
+            *cached = block_states.index_of_or_insert(self.result_state(result).clone());
+        }
+        block_states.set_index(slot, *cached);
+    }
+
+    /// Folds the programs for this chunk: by every biome set on which all the chunk's biomes
+    /// agree, and above the preliminary surface also by the chunk's lowest preliminary surface
+    /// and by `stone_depth_above` being 1 or at least 2. Two folds of the above program's
+    /// size and one per below band, per chunk; every test they drop is a pure table read or
+    /// comparison (see [`Facts::known`]).
+    fn fold_for_chunk(&mut self, biomes: &ChunkBiomes, columns: &[Column]) {
+        let mut known = Vec::with_capacity(self.biome_sets.len());
+        if biomes.count > 0 {
+            for set in 0..self.biome_sets.len() {
+                let row = &biomes.masks[set * biomes.count..(set + 1) * biomes.count];
+                known.push(if row.iter().all(|&b| b) {
+                    Some(true)
+                } else if row.iter().all(|&b| !b) {
+                    Some(false)
+                } else {
+                    None
+                });
+            }
+        }
+        let top_y = self.min_y + self.height - 1;
+        // Every position the above programs are offered has y >= its column's preliminary
+        // surface and y >= min_y.
+        let lowest = columns
+            .iter()
+            .map(|column| column.min_surface_level)
+            .min()
+            .unwrap_or(self.min_y)
+            .max(self.min_y)
+            .min(top_y);
+        for (index, (depth_lo, depth_hi)) in [(1, 1), (2, i32::MAX)].into_iter().enumerate() {
+            let facts = Facts {
+                y_lo: lowest,
+                y_hi: top_y,
+                above_preliminary_surface: Some(true),
+                depth_lo,
+                depth_hi,
+                biomes: &known,
+            };
+            let mut out = std::mem::take(&mut self.chunk_above[index]);
+            out.clear();
+            fold(&self.program, 0, self.program.len(), &facts, &mut out);
+            self.chunk_above[index] = out;
+        }
+        let mut chunk_below = std::mem::take(&mut self.chunk_below);
+        chunk_below.resize_with(self.below_programs.len(), || (BandShape::Empty, Vec::new()));
+        for (band, (shape, out)) in chunk_below.iter_mut().enumerate() {
+            let y_lo = self.below_band_lo[band];
+            let y_hi = self
+                .below_band_lo
+                .get(band + 1)
+                .map_or(top_y, |next| next - 1);
+            let facts = Facts {
+                y_lo,
+                y_hi,
+                above_preliminary_surface: Some(false),
+                depth_lo: 1,
+                depth_hi: i32::MAX,
+                biomes: &known,
+            };
+            out.clear();
+            let program = &self.below_programs[band];
+            fold(program, 0, program.len(), &facts, out);
+            *shape = match out.as_slice() {
+                [] => BandShape::Empty,
+                [Op::Block(result)] => BandShape::Block(*result),
+                _ => BandShape::General,
+            };
+        }
+        self.chunk_below = chunk_below;
+    }

+/// Whether `preliminary_surface_level`, sampled through any chunk's caches, gives bit-identical
+/// values at every block column `(x, z)` and at its quart origin `(x & !3, z & !3)`, for every
+/// y. Proven on the compiled program, from two facts:
+///
+/// 1. [`NoiseRouterEvaluator::is_y_independent`]: besides the slot's own result, it checks that
+///    every `cache_2d`/`flat_cache` argument anywhere in the program (the `find_top_surface`
+///    density included) is y-independent and cache-pure, and every `cache_once` argument
+///    cache-pure. So each cache node's value is a function of the position it samples its
+///    argument at, whichever y first filled it and through whichever caches.
+/// 2. The listing below, checked here: outside `flat_cache` arguments, the program reads x and
+///    z only through cache nodes and `find_top_surface`. Accepted ops:
+///    - `Const`, the register arithmetic (`Add` .. `Invert`), `YClampedGradient`: functions
+///      of their registers and y alone.
+///    - `Cache(kind=FlatCache)`, with any argument: it samples the argument at the quart
+///      origin, so by (1) its value is a function of `(x & !3, z & !3)`.
+///    - `Cache(kind=Cache2d)` and `Cache(kind=Once)` whose argument passes this same check:
+///      by (1) the value is the argument at `(x, y', z)` for some y', which by induction
+///      equals the argument at the quart origin.
+///    - `FindTopSurface` whose density passes this check: its scan start comes from a register
+///      (checked as an op of this program), and each density sample at `(x, y_scan, z)` equals
+///      the one at the quart origin, so the scan takes the same steps and returns the same y.
+///    - `GatedAdd` whose body passes this check: `c` when its gate register is zero, else `c`
+///      plus the gate times the body run at the same position.
+///
+///    Everything else -- noises, shifts, splines, range choices, interval selects,
+///    `interpolated` caches, or any listing line not in the expected shape -- is rejected.
+///
+/// By induction over the ops, every register holds the same bits at a column and at its quart
+/// origin. Conservative: rejecting only costs the 256 samples per chunk the pass always made.
+///
+/// `SurfaceSystem::new` runs once per chunk, so the answer is kept per thread, per router id
+/// (which no two evaluators in a process share).
+fn preliminary_snaps_to_quart(router: &NoiseRouterEvaluator) -> bool {
+    thread_local! {
+        static PROVEN: std::cell::RefCell<Vec<(u64, bool)>> =
+            const { std::cell::RefCell::new(Vec::new()) };
+    }
+    PROVEN.with(|proven| {
+        let mut proven = proven.borrow_mut();
+        if let Some((_, answer)) = proven.iter().find(|(id, _)| *id == router.id()) {
+            return *answer;
+        }
+        let answer = prove_preliminary_snaps_to_quart(router);
+        proven.push((router.id(), answer));
+        answer
+    })
+}
+
+fn prove_preliminary_snaps_to_quart(router: &NoiseRouterEvaluator) -> bool {
+    let slot = RouterSlot::PreliminarySurfaceLevel;
+    if !router.is_y_independent(slot) {
+        return false;
+    }
+    let lines = router.dump_program(slot);
+    let mut pos = 0;
+    listing_snaps_to_quart(&lines, &mut pos, 0) && pos == lines.len()
+}
+
+/// Checks the program listed from `lines[*pos]` at nesting `depth`, in the format of
+/// [`NoiseRouterEvaluator::dump_program`]: `{pad}{index:3}: {op}` per op, `pad` two spaces per
+/// depth, and each nested program after a `{pad}     {label}:` line, three depths deeper.
+/// Advances `*pos` past the program.
+fn listing_snaps_to_quart(lines: &[String], pos: &mut usize, depth: usize) -> bool {
+    const PLAIN: [&str; 14] = [
+        "Const(",
+        "Add(r",
+        "Mul(r",
+        "Min(r",
+        "Max(r",
+        "Clamp(r",
+        "Abs(r",
+        "Square(r",
+        "Cube(r",
+        "HalfNegative(r",
+        "QuarterNegative(r",
+        "Squeeze(r",
+        "Invert(r",
+        "YClampedGradient(",
+    ];
+    let pad = "  ".repeat(depth);
+    let mut index = 0usize;
+    while let Some(text) = lines
+        .get(*pos)
+        .and_then(|line| line.strip_prefix(&format!("{pad}{index:3}: ")))
+    {
+        *pos += 1;
+        index += 1;
+        // The nested program this op owns, and whether it must pass the check itself.
+        let nested = if PLAIN.iter().any(|prefix| text.starts_with(prefix)) {
+            None
+        } else if text.starts_with("FindTopSurface(") {
+            Some(("density", true))
+        } else if text.starts_with("GatedAdd(") {
+            Some(("body", true))
+        } else if text.starts_with("Cache(kind=FlatCache,") {
+            Some(("argument", false))
+        } else if text.starts_with("Cache(kind=Cache2d,") || text.starts_with("Cache(kind=Once,") {
+            Some(("argument", true))
+        } else {
+            return false;
+        };
+        let label_line = |line: &String| {
+            line.strip_prefix(&format!("{pad}     "))
+                .is_some_and(|rest| !rest.starts_with(' ') && rest.ends_with(':'))
+        };
+        let Some((label, check)) = nested else {
+            if lines.get(*pos).is_some_and(label_line) {
+                return false;
+            }
+            continue;
+        };
+        if lines.get(*pos) != Some(&format!("{pad}     {label}:")) {
+            return false;
+        }
+        *pos += 1;
+        if check {
+            if !listing_snaps_to_quart(lines, pos, depth + 3) {
+                return false;
+            }
+        } else {
+            // A `flat_cache` argument: skip its listing, every line of which is indented at
+            // least as deep as its own ops. The parent's lines are all indented less.
+            let inner = 2 * (depth + 3);
+            let start = *pos;
+            while lines
+                .get(*pos)
+                .is_some_and(|line| line.len() - line.trim_start_matches(' ').len() >= inner)
+            {
+                *pos += 1;
+            }
+            if *pos == start {
+                return false;
+            }
+        }
+        // An op owns exactly one nested program here; a second label is an unknown shape.
+        if lines.get(*pos).is_some_and(label_line) {
+            return false;
+        }
+    }
+    index > 0
+}

+    /// The proof accepts a column value read through `flat_cache` and rejects the same value
+    /// read at the exact column.
+    #[test]
+    fn quart_snapping_is_proven_only_through_flat_cache() {
+        let obj = |o: DensityFunctionObject| DensityFunction::Object(Box::new(o));
+        let noise = || {
+            obj(DensityFunctionObject::ShiftedNoise {
+                noise: ResourceLocation::minecraft("surface"),
+                xz_scale: 1.0,
+                y_scale: 0.0,
+                shift_x: DensityFunction::Constant(0.0),
+                shift_y: DensityFunction::Constant(1.0),
+                shift_z: DensityFunction::Constant(0.0),
+            })
+        };
+        let top = |upper: DensityFunction| {
+            obj(DensityFunctionObject::FindTopSurface {
+                density: obj(DensityFunctionObject::Add {
+                    argument1: upper.clone(),
+                    argument2: obj(DensityFunctionObject::YClampedGradient {
+                        from_y: -64,
+                        to_y: 320,
+                        from_value: 1.0,
+                        to_value: -1.0,
+                    }),
+                }),
+                upper_bound: upper,
+                lower_bound: -64,
+                cell_height: 8,
+            })
+        };
+        let flat = || obj(DensityFunctionObject::FlatCache { argument: noise() });
+        let cached = |argument| obj(DensityFunctionObject::Cache2d { argument });
+        assert!(router_for(top(cached(flat()))));
+        assert!(router_for(top(flat())));
+        assert!(!router_for(top(cached(noise()))));
+        assert!(!router_for(top(noise())));
+        assert!(router_for(DensityFunction::Constant(0.0)));
+    }

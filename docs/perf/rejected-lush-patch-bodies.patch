+
+/// A state a provider gave: one of its configured states, or one it built.
+pub enum Provided<'s> {
+    Config(&'s BlockState),
+    Made(BlockState),
+}
+
+impl std::ops::Deref for Provided<'_> {
+    type Target = BlockState;
+
+    fn deref(&self) -> &BlockState {
+        match self {
+            Self::Config(state) => state,
+            Self::Made(state) => state,
+        }
+    }
+}
+
+impl Provided<'_> {
+    pub fn into_owned(self) -> BlockState {
+        match self {
+            Self::Config(state) => state.clone(),
+            Self::Made(state) => state,
+        }
+    }
+}
+
+/// The states a `randomized_int_state_provider` makes of one integer-valued source state, for
+/// every value of the range its `values` provider draws from: `states[value - min]`, `None`
+/// for a value the block facts do not know.
+#[derive(Debug, Clone)]
+pub struct Rolled {
+    min: i32,
+    states: Vec<Option<BlockState>>,
+}
+
+/// Larger ranges are rolled at placement time.
+const MAX_ROLLED: i32 = 64;
+
+impl Rolled {
+    fn table(
+        source: &StateProvider,
+        property: &str,
+        values: &IntProvider,
+        facts: &BlockFacts,
+    ) -> Vec<Option<Self>> {
+        let Some((min, max)) = int_range(values) else {
+            return Vec::new();
+        };
+        if max < min || max.wrapping_sub(min) >= MAX_ROLLED {
+            return Vec::new();
+        }
+        let sources: Vec<&BlockState> = match source {
+            StateProvider::Simple(state) => vec![state],
+            StateProvider::Weighted { entries, .. } => entries.iter().map(|(s, _)| s).collect(),
+            _ => return Vec::new(),
+        };
+        sources
+            .into_iter()
+            .map(|state| {
+                let is_integer = state
+                    .properties
+                    .get(property)
+                    .is_some_and(|value| value.parse::<i32>().is_ok());
+                is_integer.then(|| Self {
+                    min,
+                    states: (min..=max)
+                        .map(|value| {
+                            let mut rolled = state.clone();
+                            rolled
+                                .properties
+                                .insert(property.to_string(), value.to_string());
+                            facts.knows(&rolled).then_some(rolled)
+                        })
+                        .collect(),
+                })
+            })
+            .collect()
+    }
+}
+
+/// The inclusive range a constant or uniform int provider draws from.
+fn int_range(values: &IntProvider) -> Option<(i32, i32)> {
+    use oxide_datapack::placement::TaggedIntProvider;
+    match values {
+        IntProvider::Constant(value) => Some((*value, *value)),
+        IntProvider::Tagged(tagged) => match &**tagged {
+            TaggedIntProvider::Constant { value } => Some((*value, *value)),
+            TaggedIntProvider::Uniform {
+                min_inclusive,
+                max_inclusive,
+            } => Some((*min_inclusive, *max_inclusive)),
+            _ => None,
+        },
+    }
+}
+
+impl StateProvider {
+    /// [`Self::state`] without copying a configured state: the same draws in the same order,
+    /// and a state equal to the one [`Self::state`] gives.
+    pub fn state_ref(
+        &self,
+        cx: &mut FeatureContext<'_, '_, '_>,
+        pos: BlockPos,
+    ) -> Result<Option<Provided<'_>>, Unsupported> {
+        Ok(match self {
+            Self::Simple(state) => Some(Provided::Config(state)),
+            Self::Weighted { entries, total } => {
+                if *total <= 0 {
+                    return Ok(None);
+                }
+                let mut remaining = cx.random.next_int_bounded(*total);
+                let mut chosen = None;
+                for (state, weight) in entries {
+                    remaining -= weight;
+                    if remaining < 0 {
+                        chosen = Some(Provided::Config(state));
+                        break;
+                    }
+                }
+                chosen
+            }
+            Self::RandomizedInt {
+                source,
+                property,
+                values,
+                rolled,
+            } => {
+                let Some(state) = source.state_ref(cx, pos)? else {
+                    return Ok(None);
+                };
+                let index = match (&**source, &state) {
+                    (Self::Simple(_), Provided::Config(_)) => Some(0),
+                    (Self::Weighted { entries, .. }, Provided::Config(picked)) => entries
+                        .iter()
+                        .position(|(entry, _)| std::ptr::eq(entry, *picked)),
+                    _ => None,
+                };
+                if let Some(table) = index.and_then(|index| rolled.get(index)) {
+                    let Some(table) = table else {
+                        // Not an integer property: left alone, nothing drawn.
+                        return Ok(Some(state));
+                    };
+                    let value = sample_int(values, cx.random);
+                    return match table.states.get(value.wrapping_sub(table.min) as usize) {
+                        Some(Some(rolled)) => Ok(Some(Provided::Config(rolled))),
+                        _ => Err(Unsupported(
+                            "randomized_int_state_provider value out of range",
+                        )),
+                    };
+                }
+                let mut state = state.into_owned();
+                let is_integer = state
+                    .properties
+                    .get(property)
+                    .is_some_and(|value| value.parse::<i32>().is_ok());
+                if is_integer {
+                    let value = sample_int(values, cx.random);
+                    state.properties.insert(property.clone(), value.to_string());
+                    if !cx.env.facts.knows(&state) {
+                        return Err(Unsupported(
+                            "randomized_int_state_provider value out of range",
+                        ));
+                    }
+                }
+                Some(Provided::Made(state))
+            }
+            Self::Noise { source, states } => {
+                if states.is_empty() {
+                    return Err(Unsupported("noise_provider without states"));
+                }
+                Some(Provided::Config(
+                    &states[pick_by_noise(states.len(), source.value(pos))],
+                ))
+            }
+            // The rest are rare; they give what `state` gives.
+            _ => self.state(cx, pos)?.map(Provided::Made),
+        })
+    }
+}

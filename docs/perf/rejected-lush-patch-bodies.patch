+    /// `allowed_placement` at `pos`, answered per state key when the predicate is local.
+    fn allowed(
+        &self,
+        cx: &mut FeatureContext<'_, '_, '_>,
+        pos: BlockPos,
+        answers: &mut AllowedCache,
+    ) -> bool {
+        if self.local {
+            if let Some(probe) = cx.region.probe(pos) {
+                let slot = &mut answers.0[probe.key.slot() & (ALLOWED_SLOTS - 1)];
+                if let Some((key, answer)) = *slot {
+                    if key == probe.key {
+                        return answer;
+                    }
+                }
+                // Inside the window `pos` is inside the world's height, which is all a local
+                // predicate asks of the position itself.
+                let answer = self.allowed_placement.test_probe(
+                    cx.env,
+                    &probe,
+                    pos,
+                    cx.region.min_y(),
+                    cx.region.max_y(),
+                );
+                *slot = Some((probe.key, answer));
+                return answer;
+            }
+        }
+        self.allowed_placement.test(cx, pos)
+    }
 }
 

+const TOGGLE_UNFILLED: u8 = 0;
+const TOGGLE_FILLED: u8 = 1;
+const TOGGLE_PER_BLOCK: u8 = 2;
+
+impl VeinType {
+    fn contains(&self, y: i32) -> bool {
+        self.min_y <= y && y <= self.max_y
+    }
+}
+
+/// The largest `edge_roundoff` `vein_state` computes for `vein` over the ys of
+/// `min_y..=max_y` inside its band -- by the same expression, so the same values -- or `None`
+/// when none of them is inside the band (and `vein` can place nothing there).
+fn max_edge_roundoff(vein: &VeinType, min_y: i32, max_y: i32) -> Option<f64> {
+    (min_y.max(vein.min_y)..=max_y.min(vein.max_y))
+        .map(|y| edge_roundoff(vein, y))
+        .reduce(f64::max)
+}
+
+/// Fades veins out over the last 20 blocks before a band's edge. `y` must be inside the band.
+fn edge_roundoff(vein: &VeinType, y: i32) -> f64 {
+    let distance_from_edge = (vein.max_y - y).min(y - vein.min_y);
+    clamped_map(
+        distance_from_edge as f64,
+        0.0,
+        EDGE_ROUNDOFF_BEGIN,
+        MAX_EDGE_ROUNDOFF,
+        0.0,
+    )
+}

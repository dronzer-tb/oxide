+    /// A recorded walk replays exactly the calls the walk itself makes, for targets all around
+    /// the tunnel's start, through the whole-tree skip and the block skips.
+    #[test]
+    fn replayed_walk_matches_the_walk() {
+        let mut outer = LegacyRandom::new(987_654_321);
+        let mut cache = TunnelCache::new();
+        let mut calls = 0usize;
+        for n in 0..300 {
+            let x = (outer.next_int_bounded(16) + 3) as f64;
+            let y = (outer.next_int_bounded(120) - 40) as f64;
+            let z = (outer.next_int_bounded(16) - 21) as f64;
+            let thickness = if n % 3 == 0 {
+                cave_thickness(&mut outer) * 2.0
+            } else {
+                cave_thickness(&mut outer)
+            };
+            let horizontal_rotation = outer.next_float() * std::f32::consts::TAU;
+            let vertical_rotation = (outer.next_float() - 0.5) / 4.0;
+            let distance = 112 - outer.next_int_bounded(28);
+            let tunnel_seed = outer.next_long();
+            let horizontal_multiplier = 0.7 + outer.next_float() as f64 * 0.7;
+            let key = TunnelKey::new(
+                tunnel_seed,
+                x,
+                y,
+                z,
+                thickness,
+                horizontal_rotation,
+                vertical_rotation,
+                0,
+                distance,
+                1.0,
+            );
+            for cx in -9..=9 {
+                for cz in -10..=8 {
+                    let pos = ChunkPos::new(cx, cz);
+                    let mut expected = Vec::new();
+                    reference_tunnel(
+                        pos,
+                        tunnel_seed,
+                        x,
+                        y,
+                        z,
+                        horizontal_multiplier,
+                        thickness,
+                        horizontal_rotation,
+                        vertical_rotation,
+                        0,
+                        distance,
+                        1.0,
+                        &mut |a: f64, b: f64, c: f64, d: f64, e: f64| {
+                            expected.push([a, b, c, d, e].map(f64::to_bits))
+                        },
+                    );
+                    let mut got = Vec::new();
+                    let walk = cache.walk(key);
+                    let center_x = pos.min_block_x() as f64 + 8.0;
+                    let center_z = pos.min_block_z() as f64 + 8.0;
+                    let widest = reach_limit(walk.max_abs_thickness, horizontal_multiplier);
+                    if !walk.bounds.misses(center_x, center_z, widest) {
+                        replay_segment(
+                            walk,
+                            0,
+                            pos,
+                            horizontal_multiplier,
+                            &mut |a: f64, b: f64, c: f64, d: f64, e: f64| {
+                                got.push([a, b, c, d, e].map(f64::to_bits))
+                            },
+                        );
+                    }
+                    assert_eq!(got, expected, "tunnel {n} at chunk {cx},{cz}");
+                    calls += expected.len();
+                }
+            }
+        }
+        assert!(
+            calls > 1000,
+            "too few carve calls ({calls}) to mean anything"
+        );
+    }

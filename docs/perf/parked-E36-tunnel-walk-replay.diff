+/// Committed steps per [`StepBlock`].
+const BLOCK_STEPS: usize = 8;
+
+/// Walks each thread's [`TunnelCache`] holds before it is emptied and starts over. A chunk draws
+/// on a few hundred tunnels, and neighbouring chunks share most of them.
+const TUNNEL_CACHE_WALKS: usize = 2048;
+
+/// Open-addressing slots in the [`TunnelCache`] index: a power of two, four per walk, so probe
+/// runs stay short even when the cache is full.
+const TUNNEL_CACHE_SLOTS: usize = 4 * TUNNEL_CACHE_WALKS;
+
+/// Every input of a tunnel walk, bit for bit: equal keys walk identically.
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct TunnelKey {
+    tunnel_seed: i64,
+    position: [u64; 3],
+    y_scale: u64,
+    /// Thickness, horizontal rotation, vertical rotation.
+    floats: [u32; 3],
+    step: i32,
+    distance: i32,
+}
+
+impl TunnelKey {
+    #[allow(clippy::too_many_arguments)]
+    fn new(
+        tunnel_seed: i64,
+        x: f64,
+        y: f64,
+        z: f64,
+        thickness: f32,
+        horizontal_rotation: f32,
+        vertical_rotation: f32,
+        step: i32,
+        distance: i32,
+        y_scale: f64,
+    ) -> Self {
+        Self {
+            tunnel_seed,
+            position: [x.to_bits(), y.to_bits(), z.to_bits()],
+            y_scale: y_scale.to_bits(),
+            floats: [
+                thickness.to_bits(),
+                horizontal_rotation.to_bits(),
+                vertical_rotation.to_bits(),
+            ],
+            step,
+            distance,
+        }
+    }
+
+    fn slot(&self) -> usize {
+        let h = (self.tunnel_seed as u64 ^ self.position[0].rotate_left(17) ^ self.position[2])
+            .wrapping_mul(0x9E37_79B9_7F4A_7C15);
+        (h >> 32) as usize & (TUNNEL_CACHE_SLOTS - 1)
+    }
+}
+
+/// One step of a walk that passed its `nextInt(4)`, so reaches `can_reach` and the carve.
+struct WalkStep {
+    x: f64,
+    y: f64,
+    z: f64,
+    /// `mth::sin(..) * thickness`, the f32 term of this step's horizontal radius.
+    radius_term: f32,
+    current_step: i32,
+}
+
+/// The x and z range of a run of steps. `finite` is false if any of them is NaN or infinite;
+/// such a range never vouches for anything.
+#[derive(Clone, Copy)]
+struct Bounds {
+    min_x: f64,
+    max_x: f64,
+    min_z: f64,
+    max_z: f64,
+    finite: bool,
+}
+
+impl Bounds {
+    /// Covers no step: misses everything, which is right for a run that carves nothing.
+    const EMPTY: Self = Self {
+        min_x: f64::INFINITY,
+        max_x: f64::NEG_INFINITY,
+        min_z: f64::INFINITY,
+        max_z: f64::NEG_INFINITY,
+        finite: true,
+    };
+
+    fn add(&mut self, x: f64, z: f64) {
+        if !(x.is_finite() && z.is_finite()) {
+            self.finite = false;
+            return;
+        }
+        self.min_x = self.min_x.min(x);
+        self.max_x = self.max_x.max(x);
+        self.min_z = self.min_z.min(z);
+        self.max_z = self.max_z.max(z);
+    }
+
+    fn merge(&mut self, other: &Self) {
+        self.finite &= other.finite;
+        self.min_x = self.min_x.min(other.min_x);
+        self.max_x = self.max_x.max(other.max_x);
+        self.min_z = self.min_z.min(other.min_z);
+        self.max_z = self.max_z.max(other.max_z);
+    }
+
+    /// True only if every covered step fails the pre-check `|x - cx| > limit || |z - cz| >
+    /// limit`. Rounded subtraction is monotone, so for every `x <= max_x < cx`,
+    /// `|x - cx| >= |max_x - cx|`, and the same on the other side and in z.
+    fn misses(&self, center_x: f64, center_z: f64, limit: f64) -> bool {
+        if !self.finite {
+            return false;
+        }
+        if self.min_x > self.max_x {
+            return true; // no steps at all
+        }
+        (self.max_x < center_x && (self.max_x - center_x).abs() > limit)
+            || (self.min_x > center_x && (self.min_x - center_x).abs() > limit)
+            || (self.max_z < center_z && (self.max_z - center_z).abs() > limit)
+            || (self.min_z > center_z && (self.min_z - center_z).abs() > limit)
+    }
+
+    /// True only if every covered step, none later than `last_step`, passes [`can_reach`]:
+    /// the same expression on the largest `|dx|`, `|dz|` and the smallest remaining count.
+    /// Each operation in it rounds monotonically, so no step's own value exceeds this one.
+    fn can_reach_all(
+        &self,
+        pos: ChunkPos,
+        last_step: i32,
+        total_steps: i32,
+        thickness: f32,
+    ) -> bool {
+        if !self.finite {
+            return false;
+        }
+        let middle_x = pos.min_block_x() as f64 + 8.0;
+        let middle_z = pos.min_block_z() as f64 + 8.0;
+        let dx = (self.min_x - middle_x)
+            .abs()
+            .max((self.max_x - middle_x).abs());
+        let dz = (self.min_z - middle_z)
+            .abs()
+            .max((self.max_z - middle_z).abs());
+        let remaining = (total_steps - last_step) as f64;
+        let reach = (thickness + 2.0 + 16.0) as f64;
+        dx * dx + dz * dz - remaining * remaining <= reach * reach
+    }
+}
+
+/// Up to [`BLOCK_STEPS`] consecutive steps of one segment.
+struct StepBlock {
+    bounds: Bounds,
+    /// The latest `current_step` in the block (steps increase along a segment).
+    last_step: i32,
+}
+
+/// One tunnel's own run of steps within a [`TunnelWalk`].
+struct Segment {
+    thickness: f32,
+    y_scale: f64,
+    /// Range into [`TunnelWalk::steps`].
+    steps: (u32, u32),
+    /// Range into [`TunnelWalk::blocks`].
+    blocks: (u32, u32),
+    /// The two segments this one splits into after its last step.
+    split: Option<[u32; 2]>,
+}
+
+/// A tunnel's whole walk, independent of the chunk being carved. Segment 0 is the tunnel itself.
+struct TunnelWalk {
+    key: Option<TunnelKey>,
+    distance: i32,
+    steps: Vec<WalkStep>,
+    blocks: Vec<StepBlock>,
+    segments: Vec<Segment>,
+    /// Over every step of every segment.
+    bounds: Bounds,
+    max_abs_thickness: f32,
+}
+
+impl TunnelWalk {
+    const fn empty() -> Self {
+        Self {
+            key: None,
+            distance: 0,
+            steps: Vec::new(),
+            blocks: Vec::new(),
+            segments: Vec::new(),
+            bounds: Bounds::EMPTY,
+            max_abs_thickness: 0.0,
+        }
+    }
+
+    /// Re-records this slot for `key`, reusing its buffers.
+    fn record(&mut self, key: TunnelKey) {
+        self.key = None;
+        self.steps.clear();
+        self.blocks.clear();
+        self.segments.clear();
+        self.distance = key.distance;
+        record_segment(
+            self,
+            key.tunnel_seed,
+            f64::from_bits(key.position[0]),
+            f64::from_bits(key.position[1]),
+            f64::from_bits(key.position[2]),
+            f32::from_bits(key.floats[0]),
+            f32::from_bits(key.floats[1]),
+            f32::from_bits(key.floats[2]),
+            key.step,
+            key.distance,
+            f64::from_bits(key.y_scale),
         );
+        let mut all = Bounds::EMPTY;
+        let mut max_abs_thickness = 0.0f32;
+        for segment in &mut self.segments {
+            let first_block = self.blocks.len() as u32;
+            let steps = &self.steps[segment.steps.0 as usize..segment.steps.1 as usize];
+            for run in steps.chunks(BLOCK_STEPS) {
+                let mut bounds = Bounds::EMPTY;
+                for step in run {
+                    bounds.add(step.x, step.z);
+                }
+                all.merge(&bounds);
+                self.blocks.push(StepBlock {
+                    bounds,
+                    last_step: run[run.len() - 1].current_step,
+                });
+            }
+            segment.blocks = (first_block, self.blocks.len() as u32);
+            // NaN thickness: no finite limit to vouch with.
+            if segment.thickness.is_nan() {
+                all.finite = false;
+            }
+            max_abs_thickness = max_abs_thickness.max(segment.thickness.abs());
+        }
+        self.bounds = all;
+        self.max_abs_thickness = max_abs_thickness;
+        self.key = Some(key);
+    }
+}
+
+/// A thread's recorded tunnel walks: an open-addressing index (linear probing) over a pool of
+/// walks, the full key compared on every hit. When the pool is full, everything is dropped at
+/// once and recording starts over, reusing the buffers. (A direct-mapped table loses here: two
+/// tunnels that share a slot and are both in range of a chunk re-record each other every chunk.)
+/// Holds nothing but pure functions of keys.
+struct TunnelCache {
+    /// `0` for an empty slot, else an index into `walks` plus one.
+    index: Vec<u32>,
+    walks: Vec<TunnelWalk>,
+    /// Walks in `walks[..live]` are current; the rest are spare buffers.
+    live: usize,
+}
+
+impl TunnelCache {
+    fn new() -> Self {
+        Self {
+            index: vec![0; TUNNEL_CACHE_SLOTS],
+            walks: Vec::new(),
+            live: 0,
+        }
+    }
+
+    fn walk(&mut self, key: TunnelKey) -> &TunnelWalk {
+        let mut slot = key.slot();
+        loop {
+            match self.index[slot] {
+                0 => break,
+                n if self.walks[n as usize - 1].key == Some(key) => {
+                    return &self.walks[n as usize - 1];
+                }
+                _ => slot = (slot + 1) & (TUNNEL_CACHE_SLOTS - 1),
+            }
+        }
+        if self.live == TUNNEL_CACHE_WALKS {
+            self.index.fill(0);
+            self.live = 0;
+            slot = key.slot();
+        }
+        if self.live == self.walks.len() {
+            self.walks.push(TunnelWalk::empty());
+        }
+        let n = self.live;
+        self.live += 1;
+        self.index[slot] = n as u32 + 1;
+        let walk = &mut self.walks[n];
+        walk.record(key);
+        walk
     }
 }
 

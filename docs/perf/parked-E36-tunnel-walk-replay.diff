+/// An upper bound on `16 + 2 * |horizontal_radius * horizontal_multiplier|` over every step of
+/// a tunnel of this thickness: the table sine is at most 1 in magnitude, so
+/// `|sin * thickness| <= |thickness|` after rounding, and every later operation rounds
+/// monotonically. With it, `carve_ellipsoid`'s own first test (`|x - center| > 16 + 2r`) can be
+/// decided without the step's radius; the pre-check only ever skips a call that would have
+/// returned at that test.
+#[inline]
+fn reach_limit(thickness: f32, horizontal_multiplier: f64) -> f64 {
+    16.0 + ((1.5 + thickness.abs() as f64) * horizontal_multiplier.abs()) * 2.0
+}
+
+/// Replays one segment of a recorded walk against the target chunk, then (if it was not ended
+/// by `can_reach`) the two tunnels it splits into. `carve` gets each surviving step's centre,
+/// its horizontal radius already multiplied by the carver's multiplier, and its vertical radius
+/// before the vertical multiplier -- exactly the operands the unrecorded walk computed.
+fn replay_segment(
+    walk: &TunnelWalk,
+    segment: usize,
+    pos: ChunkPos,
+    horizontal_multiplier: f64,
+    carve: &mut impl FnMut(f64, f64, f64, f64, f64),
+) {
+    let seg = &walk.segments[segment];
+    let thickness = seg.thickness;
+    let distance = walk.distance;
+    let limit = reach_limit(thickness, horizontal_multiplier);
+    let center_x = pos.min_block_x() as f64 + 8.0;
+    let center_z = pos.min_block_z() as f64 + 8.0;
+    let blocks = &walk.blocks[seg.blocks.0 as usize..seg.blocks.1 as usize];
+    for (b, block) in blocks.iter().enumerate() {
+        // Every step of the block passes `can_reach` and is skipped by the pre-check: the block
+        // has no effect and the walk goes on past it, as it would step by step.
+        if block.bounds.misses(center_x, center_z, limit)
+            && block
+                .bounds
+                .can_reach_all(pos, block.last_step, distance, thickness)
+        {
+            continue;
+        }
+        let first = seg.steps.0 as usize + b * BLOCK_STEPS;
+        let last = (first + BLOCK_STEPS).min(seg.steps.1 as usize);
+        for step in &walk.steps[first..last] {
+            if !can_reach(pos, step.x, step.z, step.current_step, distance, thickness) {
+                return;
+            }
+            if (step.x - center_x).abs() > limit || (step.z - center_z).abs() > limit {
+                continue;
+            }
+            let horizontal_radius = 1.5 + step.radius_term as f64;
+            let vertical_radius = horizontal_radius * seg.y_scale;
+            carve(
+                step.x,
+                step.y,
+                step.z,
+                horizontal_radius * horizontal_multiplier,
+                vertical_radius,
+            );
+        }
+    }
+    if let Some([a, b]) = seg.split {
+        replay_segment(walk, a as usize, pos, horizontal_multiplier, carve);
+        replay_segment(walk, b as usize, pos, horizontal_multiplier, carve);
+    }
+}

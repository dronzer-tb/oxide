+/// log2 of the entries in one [`SharedSurface`] table: 2^17 words, 1 MiB per router.
+const SHARED_SURFACE_BITS: u32 = 17;
+/// Routers whose [`SharedSurface`] tables are kept; the oldest is dropped past this.
+const SHARED_SURFACE_ROUTERS: usize = 8;
+
+/// `preliminary_surface_level` per quart column, shared by every thread generating against one
+/// router.
+///
+/// [`SurfaceMemo`] is per thread, so on 8 threads each column near the boundary between two
+/// threads' chunks is scanned once by each of them: measured at 8 threads, the scan went from
+/// 1.4% of generation time to 4.1%. This table sits behind the per-thread memo and lets any
+/// thread reuse a column another thread already scanned.
+///
+/// Exact by construction. A level is a pure function of the router and the quart column (the
+/// argument at `preliminary_surface_level` below, which the per-thread memo already relies on
+/// across chunks), and each entry is one atomic word holding its full key next to its value,
+/// so a load sees either a complete entry -- whose key is then compared -- or not the column.
+/// Direct-mapped and lossy: a colliding store replaces the entry, which only costs a rescan.
+/// Columns or levels that do not fit the packing are simply not shared.
+struct SharedSurface {
+    router_id: u64,
+    entries: Box<[std::sync::atomic::AtomicU64]>,
+}
+
+/// Quart coordinate bits in a [`SharedSurface`] entry: +-2^23 quarts covers +-33M blocks.
+const SHARED_KEY_BITS: u32 = 24;
+/// The value field of an empty entry. Never stored: `i16::MIN` is not a level the table keeps.
+const SHARED_EMPTY: u64 = 0x8000;
+
+impl SharedSurface {
+    /// The table for `router_id`, created on first use. One lock per aquifer (per chunk), not
+    /// per lookup.
+    fn for_router(router_id: u64) -> std::sync::Arc<SharedSurface> {
+        static TABLES: std::sync::Mutex<Vec<std::sync::Arc<SharedSurface>>> =
+            std::sync::Mutex::new(Vec::new());
+        let mut tables = TABLES
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        if let Some(table) = tables.iter().find(|t| t.router_id == router_id) {
+            return table.clone();
+        }
+        if tables.len() >= SHARED_SURFACE_ROUTERS {
+            tables.remove(0);
+        }
+        let table = std::sync::Arc::new(SharedSurface {
+            router_id,
+            entries: (0..1usize << SHARED_SURFACE_BITS)
+                .map(|_| std::sync::atomic::AtomicU64::new(SHARED_EMPTY))
+                .collect(),
+        });
+        tables.push(table.clone());
+        table
+    }
+
+    /// The entry word index and the key bits for quart column `(qx, qz)` (in quarts), or `None`
+    /// when it does not fit the key.
+    #[inline]
+    fn locate(qx: i32, qz: i32) -> Option<(usize, u64)> {
+        let fits =
+            |v: i32| (-(1 << (SHARED_KEY_BITS - 1))..1 << (SHARED_KEY_BITS - 1)).contains(&v);
+        if !fits(qx) || !fits(qz) {
+            return None;
+        }
+        let mask = (1u64 << SHARED_KEY_BITS) - 1;
+        let key = ((qx as u32 as u64 & mask) << SHARED_KEY_BITS) | (qz as u32 as u64 & mask);
+        let mut h = key.wrapping_mul(0x9E37_79B9_7F4A_7C15);
+        h ^= h >> 29;
+        let index = (h >> (64 - SHARED_SURFACE_BITS)) as usize;
+        Some((index, key << 16))
+    }
+
+    #[inline]
+    fn get(&self, qx: i32, qz: i32) -> Option<i32> {
+        let (index, key) = Self::locate(qx, qz)?;
+        let word = self.entries[index].load(std::sync::atomic::Ordering::Relaxed);
+        let value = word & 0xFFFF;
+        (word & !0xFFFF == key && value != SHARED_EMPTY).then_some(value as u16 as i16 as i32)
+    }
+
+    #[inline]
+    fn put(&self, qx: i32, qz: i32, level: i32) {
+        let Some((index, key)) = Self::locate(qx, qz) else {
+            return;
+        };
+        if level <= i16::MIN as i32 || level > i16::MAX as i32 {
+            return;
+        }
+        self.entries[index].store(
+            key | (level as i16 as u16 as u64),
+            std::sync::atomic::Ordering::Relaxed,
+        );
+    }
+}

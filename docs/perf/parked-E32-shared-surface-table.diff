+    /// A shared entry gives back exactly the level stored for exactly its column, an empty
+    /// or colliding entry gives nothing, and levels or columns outside the packing are never
+    /// stored rather than stored wrong.
+    #[test]
+    fn shared_surface_entries_are_exact() {
+        let table = SharedSurface {
+            router_id: 0,
+            entries: (0..1usize << SHARED_SURFACE_BITS)
+                .map(|_| std::sync::atomic::AtomicU64::new(SHARED_EMPTY))
+                .collect(),
+        };
+        let edge = (1 << (SHARED_KEY_BITS - 1)) - 1;
+        let columns = [
+            (0, 0),
+            (-1, -1),
+            (5, -7),
+            (-edge - 1, edge),
+            (edge, -edge - 1),
+        ];
+        for &(qx, qz) in &columns {
+            assert_eq!(table.get(qx, qz), None, "empty table at {qx},{qz}");
+        }
+        for (i, &(qx, qz)) in columns.iter().enumerate() {
+            let level = [0, -1, 63, i16::MAX as i32, i16::MIN as i32 + 1][i];
+            table.put(qx, qz, level);
+            assert_eq!(table.get(qx, qz), Some(level), "at {qx},{qz}");
+        }
+        // Not representable: never stored, so never returned.
+        table.put(1, 2, i16::MIN as i32);
+        table.put(3, 4, 40_000);
+        table.put(edge + 1, 0, 1);
+        assert_eq!(table.get(1, 2), None);
+        assert_eq!(table.get(3, 4), None);
+        assert_eq!(table.get(edge + 1, 0), None);
+        // A column that maps to an occupied word is not mistaken for its occupant.
+        let (index, _) = SharedSurface::locate(5, -7).unwrap();
+        let other = (-2000..2000)
+            .flat_map(|x| (-200..200).map(move |z| (x, z)))
+            .find(|&(x, z)| (x, z) != (5, -7) && SharedSurface::locate(x, z).unwrap().0 == index)
+            .expect("a colliding column");
+        assert_eq!(table.get(other.0, other.1), None);
+        table.put(other.0, other.1, 12);
+        assert_eq!(table.get(other.0, other.1), Some(12));
+        assert_eq!(table.get(5, -7), None);
+    }

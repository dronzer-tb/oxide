diff --git a/crates/oxide-chunkgen/src/decorator/prof.rs b/crates/oxide-chunkgen/src/decorator/prof.rs
new file mode 100644
index 0000000..6ac8a3a
--- /dev/null
+++ b/crates/oxide-chunkgen/src/decorator/prof.rs
@@ -0,0 +1,164 @@
+//! TEMPORARY decoration profiling (scratch only, never commit). Thread-local counters flushed
+//! into global atomics at the end of each `BiomeDecorator::decorate`; one call in `SAMPLE` of
+//! each region primitive is timed. Reported once, from `BiomeDecorator`'s `Drop`.
+
+use std::cell::Cell;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::OnceLock;
+use std::time::Instant;
+
+use oxide_core::BlockState;
+use oxide_datapack::{BlockFact, BlockFacts};
+
+/// Prime stride, on a counter never reset: a power-of-two stride aliases with HashMap growth.
+pub const SAMPLE: u64 = 61;
+pub const N: usize = 7;
+pub const IS: usize = 0;
+pub const BLOCK: usize = 1;
+pub const HEIGHT: usize = 2;
+pub const SET_BLOCK: usize = 3;
+pub const FACTS_IS: usize = 4;
+pub const BIOMES_PRESENT: usize = 5;
+pub const INTO_WRITES: usize = 6;
+const NAMES: [&str; N] = [
+    "DecorationRegion::is",
+    "DecorationRegion::block",
+    "DecorationRegion::height",
+    "DecorationRegion::set_block",
+    "BlockFacts::is (all decorator call sites)",
+    "DecorationRegion::biomes_present",
+    "DecorationRegion::into_writes",
+];
+
+thread_local! {
+    static CALLS: [Cell<u64>; N] = Default::default();
+    static NS: [Cell<u64>; N] = Default::default();
+    static SAMPLES: [Cell<u64>; N] = Default::default();
+    static SEQ: [Cell<u64>; N] = Default::default();
+}
+
+static G_CALLS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+static G_NS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+static G_SAMPLES: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+pub static DECORATE_NS: AtomicU64 = AtomicU64::new(0);
+pub static DECORATE_CALLS: AtomicU64 = AtomicU64::new(0);
+pub static FEATURES_NS: AtomicU64 = AtomicU64::new(0);
+
+/// Per top-level placed feature key: [ns, invocations, set_block, is, block, height, facts_is].
+pub static FEATURES: OnceLock<(Vec<String>, Vec<[AtomicU64; 7]>)> = OnceLock::new();
+
+/// Counts a call; returns a start time for one call in `SAMPLE`.
+#[inline]
+pub fn start(op: usize) -> Option<Instant> {
+    CALLS.with(|c| c[op].set(c[op].get() + 1));
+    SEQ.with(|c| {
+        let n = c[op].get() + 1;
+        c[op].set(n);
+        (n % SAMPLE == 0).then(Instant::now)
+    })
+}
+
+#[inline]
+pub fn end(op: usize, t: Option<Instant>) {
+    if let Some(t) = t {
+        let ns = t.elapsed().as_nanos() as u64;
+        NS.with(|c| c[op].set(c[op].get() + ns));
+        SAMPLES.with(|c| c[op].set(c[op].get() + 1));
+    }
+}
+
+/// Always-timed variant for rare calls.
+#[inline]
+pub fn end_always(op: usize, t: Instant) {
+    let ns = t.elapsed().as_nanos() as u64;
+    NS.with(|c| c[op].set(c[op].get() + ns));
+    SAMPLES.with(|c| c[op].set(c[op].get() + 1));
+}
+
+#[inline]
+pub fn count(op: usize) {
+    CALLS.with(|c| c[op].set(c[op].get() + 1));
+}
+
+pub fn calls(op: usize) -> u64 {
+    CALLS.with(|c| c[op].get())
+}
+
+/// `BlockFacts::is`, counted and sampled.
+#[inline]
+pub fn fis(facts: &BlockFacts, state: &BlockState, fact: BlockFact) -> bool {
+    let t = start(FACTS_IS);
+    let r = facts.is(state, fact);
+    end(FACTS_IS, t);
+    r
+}
+
+pub fn flush() {
+    CALLS.with(|c| {
+        NS.with(|ns| {
+            SAMPLES.with(|s| {
+                for i in 0..N {
+                    G_CALLS[i].fetch_add(c[i].replace(0), Relaxed);
+                    G_NS[i].fetch_add(ns[i].replace(0), Relaxed);
+                    G_SAMPLES[i].fetch_add(s[i].replace(0), Relaxed);
+                }
+            })
+        })
+    });
+}
+
+pub fn snapshot() -> [u64; 5] {
+    [calls(SET_BLOCK), calls(IS), calls(BLOCK), calls(HEIGHT), calls(FACTS_IS)]
+}
+
+pub fn report() {
+    let ms = |ns: u64| ns as f64 / 1e6;
+    let dec = DECORATE_NS.load(Relaxed);
+    println!(
+        "PROF decorate() calls={} cpu_ms={:.0} in_features_cpu_ms={:.0}",
+        DECORATE_CALLS.load(Relaxed),
+        ms(dec),
+        ms(FEATURES_NS.load(Relaxed))
+    );
+    println!("PROF --- region primitives (inclusive; is includes block; height includes is) ---");
+    for i in 0..N {
+        let calls = G_CALLS[i].load(Relaxed);
+        let samples = G_SAMPLES[i].load(Relaxed).max(1);
+        let ns = G_NS[i].load(Relaxed);
+        let per = ns as f64 / samples as f64;
+        let est = if i == BIOMES_PRESENT || i == INTO_WRITES { ns as f64 } else { per * calls as f64 };
+        println!(
+            "PROF {:<44} calls={:>12} ns_per_call={:>8.1} est_cpu_ms={:>8.0} ({:>4.1}% of decorate cpu)",
+            NAMES[i],
+            calls,
+            per,
+            est / 1e6,
+            100.0 * est / dec.max(1) as f64
+        );
+    }
+    let Some((names, stats)) = FEATURES.get() else {
+        return;
+    };
+    let mut rows: Vec<(usize, [u64; 7])> = stats
+        .iter()
+        .enumerate()
+        .map(|(k, s)| (k, std::array::from_fn(|j| s[j].load(Relaxed))))
+        .filter(|(_, s)| s[1] > 0)
+        .collect();
+    rows.sort_by(|a, b| b.1[0].cmp(&a.1[0]));
+    println!("PROF --- top placed features by cpu (of {} with any invocations) ---", rows.len());
+    for (k, s) in rows.iter().take(25) {
+        println!(
+            "PROF {:<48} cpu_ms={:>7.0} ({:>4.1}%) runs={:>6} set_block={:>9} is={:>10} block={:>10} height={:>8} facts_is={:>10}",
+            names[*k],
+            ms(s[0]),
+            100.0 * s[0] as f64 / dec.max(1) as f64,
+            s[1],
+            s[2],
+            s[3],
+            s[4],
+            s[5],
+            s[6]
+        );
+    }
+}
